{# The judge's order as they submitted it, read only, which the page's script renders from its Docweave document. #}
<script type="application/json" id="order-preview-document">{{ orderSnapshotJson | safe }}</script>
<div class="pcs-order-preview" data-order-preview aria-label="Order the Judge submitted" role="region">
  <p class="govuk-body">The order preview needs JavaScript to show.</p>
</div>
