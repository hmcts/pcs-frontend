{# The judge's order as they submitted it, read only, as Docweave renders its document. #}
<div class="pcs-order-preview" data-order-preview aria-label="Order the Judge submitted" role="region">
  {% if orderPreviewHtml %}
    {{ orderPreviewHtml | safe }}
  {% else %}
    <p class="govuk-body">The Judge did not write in the order preview.</p>
  {% endif %}
</div>
