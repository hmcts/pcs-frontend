{% extends "xui-layout.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}

{% set pageHeading = "No order to review" %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">No order to review</h1>
      {% for reason in reasons %}
        <p class="govuk-body">{{ reason }}</p>
      {% endfor %}
      {{ govukButton({ text: "Return to case details", href: closeUrl }) }}
    </div>
  </div>
{% endblock %}
