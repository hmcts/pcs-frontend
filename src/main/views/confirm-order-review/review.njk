{% extends "confirm-order-review/_layout.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "macros/csrf.njk" import csrfProtection %}
{% from "govuk/components/character-count/macro.njk" import govukCharacterCount %}
{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}

{% set pageHeading = "Review the order" %}
{% set orderPreviewHeading = "Order to issue" %}

{% block page %}
  <div class="pcs-review-page">
    <form method="post" action="{{ formAction }}" novalidate id="review-order-form">
      {{ csrfProtection(csrfToken) }}
      <input type="hidden" name="reviewOrderId" value="{{ reviewOrderId }}">

      {% include "make-order/_whole-file.njk" %}

      {% if freeForm %}
        {{ govukWarningText({
          text: "The Judge has created a custom order. Review the full order before issuing",
          attributes: { id: "free-form-warning" }
        }) }}
      {% endif %}

      {% if edits.added or edits.changed %}
        {% set editsHtml %}
          <ul class="govuk-list govuk-list--bullet govuk-!-margin-bottom-0">
            {% if edits.added %}
              <li>The Judge added wording to the order. Check the wording and any follow-up before issue</li>
            {% endif %}
            {% if edits.changed %}
              <li>The Judge changed generated wording. Check the edited wording before issuing</li>
            {% endif %}
          </ul>
        {% endset %}
        {{ govukNotificationBanner({
          titleText: "The Judge edited this order",
          html: editsHtml,
          attributes: { id: "judge-edits" }
        }) }}
      {% endif %}

      {% if staffMessage %}
        <section class="govuk-inset-text" id="judge-message" aria-labelledby="judge-message-heading">
          <h2 class="govuk-heading-s govuk-!-margin-bottom-2" id="judge-message-heading">Message from the Judge</h2>
          <p class="govuk-body pcs-preserve-lines govuk-!-margin-bottom-0">{{ staffMessage }}</p>
        </section>
      {% endif %}

      {% include "make-order/_editor.njk" %}
      {% if judgeDocument %}
        <script type="application/json" id="judge-order-document">{{ judgeDocument | jsonScript | safe }}</script>
        {# Shown by the page's script, which runs the editor it restores. #}
        <button type="button" class="govuk-button govuk-button--secondary" id="restore-judge-wording" hidden>
          Restore the Judge's wording
        </button>
      {% endif %}

      {% set queryHtml %}
        {{ govukCharacterCount({
          name: "query-to-judge",
          id: "query-to-judge",
          maxlength: maxQueryLength,
          label: { text: "Your query for the Judge" },
          value: answers.queryToJudge,
          errorMessage: validationErrors["query-to-judge"]
        }) }}
      {% endset %}
      {{ govukCheckboxes({
        name: "send-query",
        idPrefix: "send-query",
        classes: "govuk-checkboxes--small",
        fieldset: { legend: { text: "Do you have a query for the Judge?", classes: "govuk-fieldset__legend--m" } },
        hint: { text: "The order will be returned to the Judge with your query" },
        errorMessage: validationErrors["send-query"],
        items: [{
          value: "yes",
          text: "Send query to Judge",
          checked: answers.sendQuery,
          conditional: { html: queryHtml }
        }]
      }) }}

      <div class="govuk-button-group">
        {{ govukButton({ text: "Continue", name: "action", value: "ISSUE" }) }}
        {{ govukButton({
          text: "Return to Judge",
          classes: "govuk-button--secondary",
          name: "action",
          value: "RETURN_TO_JUDGE",
          preventDoubleClick: true
        }) }}
        <a class="govuk-link" href="{{ cancelUrl }}">Cancel</a>
      </div>
    </form>
  </div>
{% endblock %}
