{% extends "confirm-order-review/_layout.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "macros/csrf.njk" import csrfProtection %}
{% from "govuk/components/character-count/macro.njk" import govukCharacterCount %}
{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}

{# The make order form's layout, for the Judge's form the caseworker may change. #}
{% set htmlClasses = "pcs-make-order" %}

{% set pageHeading = "Review an order" %}
{% set orderPreviewHeading = "Order to issue" %}

{% block page %}
  {# The make order page's script runs the Judge's form and its order editor, which it finds by this id. #}
  <form method="post" action="{{ formAction }}" novalidate id="make-order-form"
        data-property-address="{{ propertyAddressDisplay }}">
    {{ csrfProtection(csrfToken) }}

    {% if edits.added or edits.changed %}
      {% set editsHtml %}
        <p class="govuk-notification-banner__heading">Order preview edited by the Judge</p>
        <ul class="govuk-list govuk-list--bullet">
          {% if edits.added %}
            <li>The Judge added wording to the order. Check the wording and any follow-up before issue</li>
          {% endif %}
          {% if edits.changed %}
            <li>The Judge changed generated wording. Check the fields below still reflect the order</li>
          {% endif %}
        </ul>
      {% endset %}
      {{ govukNotificationBanner({
        titleText: "The Judge edited this order",
        html: editsHtml,
        attributes: { id: "judge-edits" }
      }) }}
    {% endif %}

    {% if staffMessage %}
      <h2 class="govuk-heading-m">Message from the Judge</h2>
      {{ govukInsetText({
        html: '<p class="govuk-body pcs-preserve-lines">' + (staffMessage | escape) + '</p>',
        attributes: { id: "judge-message" }
      }) }}
    {% endif %}

    {# What the Judge submitted stays on the page, read only, whatever the caseworker changes below it. #}
    <details class="govuk-details" open id="judge-order">
      <summary class="govuk-details__summary">
        <span class="govuk-details__summary-text">Order the Judge submitted</span>
      </summary>
      <div class="govuk-details__text">
        {% if edits.added or edits.changed %}
          <p class="govuk-body" id="judge-changes-key">
            Clauses the Judge added are highlighted in green. Generated clauses they changed are highlighted in blue.
          </p>
        {% endif %}
        {% include "confirm-order-review/_order-preview.njk" %}
      </div>
    </details>

    <h2 class="govuk-heading-l">Check the order before you issue it</h2>
    <p class="govuk-body" id="order-changes-guidance">
      These are the Judge's answers and the order they generate. You can change the answers and the wording
      of the order. The order the Judge submitted is kept as it is shown above.
    </p>

    {% include "make-order/_form.njk" %}

    {% set queryHtml %}
      {{ govukCharacterCount({
        name: "query-to-judge",
        id: "query-to-judge",
        maxlength: maxQueryLength,
        label: { text: "Your query for the Judge" },
        value: answers.queryToJudge,
        errorMessage: validationErrors["query-to-judge"]
      }) }}
    {% endset %}
    {{ govukCheckboxes({
      name: "send-query",
      idPrefix: "send-query",
      fieldset: { legend: { text: "Do you have a query for the Judge?", classes: "govuk-fieldset__legend--m" } },
      hint: { text: "The order will be returned to the Judge with your query" },
      errorMessage: validationErrors["send-query"],
      items: [{
        value: "yes",
        text: "Send query to Judge",
        checked: answers.sendQuery,
        conditional: { html: queryHtml }
      }]
    }) }}

    <div class="govuk-button-group">
      {{ govukButton({ text: "Issue order", name: "action", value: "ISSUE" }) }}
      {{ govukButton({
        text: "Return to Judge",
        classes: "govuk-button--secondary",
        name: "action",
        value: "RETURN_TO_JUDGE",
        preventDoubleClick: true
      }) }}
      <a class="govuk-link" href="{{ cancelUrl }}">Cancel</a>
    </div>
  </form>
{% endblock %}
