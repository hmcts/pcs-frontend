{#
  What court staff check before choosing who the order is served on: its answers as they now are, with the Judge's own
  where staff changed them. The answers do not show that the wording matches them, so staff check the order too.
#}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

<h3 class="govuk-heading-s govuk-!-margin-bottom-1">About this order</h3>
<p class="govuk-body-s">From the order's answers. The wording may have been edited, so check the order to issue.</p>
{% set rows = [] %}
{% for row in issueSummary %}
  {% set valueHtml %}
    <span class="pcs-preserve-lines">{% for line in row.lines %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}</span>
  {% endset %}
  {% set rows = (rows.push({ key: { text: row.key }, value: { html: valueHtml } }), rows) %}
{% endfor %}
{{ govukSummaryList({ rows: rows, classes: "pcs-compact-summary", attributes: { id: "issue-summary" } }) }}
