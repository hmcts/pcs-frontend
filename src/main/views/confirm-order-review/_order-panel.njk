{#
  The order across the top of a page, above the questions court staff answer from it, as the Judge's case facts sit
  above their form. At desktop sizes it stays in view as the page scrolls, up to a share of the screen, with the
  order scrolling on its own, and staff can hide it to a line; on smaller screens, or zoomed in, it is part of the
  page. The Judge's message to court staff, which is often what to do with the order, sits beside it.
#}
{% macro panel(heading, staffMessage) %}
  <section class="pcs-order-panel" aria-labelledby="order-panel-heading" data-order-panel>
    <div class="pcs-order-panel__header">
      <h2 class="govuk-heading-s" id="order-panel-heading">{{ heading }}</h2>
      {# Only with the page's script, which hides and shows the order. #}
      <button type="button" class="pcs-order-panel__toggle" aria-expanded="true" aria-controls="order-panel-content"
              data-order-panel-toggle hidden>Hide order</button>
    </div>
    <div class="pcs-order-panel__content{% if staffMessage %} pcs-order-panel__content--with-message{% endif %}"
         id="order-panel-content">
      {% if staffMessage %}
        <div class="pcs-order-panel__message" id="judge-message">
          <h3 class="govuk-body-s govuk-!-font-weight-bold govuk-!-margin-bottom-1">Message from the Judge</h3>
          <p class="govuk-body-s pcs-preserve-lines govuk-!-margin-bottom-0">{{ staffMessage }}</p>
        </div>
      {% endif %}
      {# Scrolls on its own, so it takes keyboard focus to scroll by keyboard. #}
      <div class="pcs-order-panel__order" tabindex="0" role="region" aria-label="{{ heading }}">
        {{ caller() }}
      </div>
    </div>
  </section>
{% endmacro %}

{# The order as it will be issued, with any changes court staff made. #}
{% macro issuing(issuingHtml) %}
  <div class="pcs-order-preview" id="issuing-order">
    {{ issuingHtml | safe }}
  </div>
{% endmacro %}
