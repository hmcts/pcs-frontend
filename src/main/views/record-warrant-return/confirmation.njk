{% extends "xui-layout.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "macros/caseTitle.njk" import caseTitle %}
{% from "macros/xuiConfirmationPanel.njk" import xuiConfirmationPanel %}

{% set pageHeading = title %}

{% block content %}
  {{ caseTitle({
    eventName: "Record warrant return",
    caseReference: caseReferenceDisplay,
    propertyAddress: propertyAddressDisplay,
    caseName: caseName
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {{ xuiConfirmationPanel({ title: title, bodyLines: bodyLines }) }}
      {{ govukButton({ text: "Close and return to case summary", href: closeUrl }) }}
    </div>
  </div>
{% endblock %}
