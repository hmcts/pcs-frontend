{% extends "record-warrant-return/_layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/character-count/macro.njk" import govukCharacterCount %}
{% from "govuk/components/date-input/macro.njk" import govukDateInput %}
{% import "macros/xuiButtons.njk" as buttons with context %}
{% from "macros/dateTimeInput.njk" import dateInput %}
{% from "macros/csrf.njk" import csrfProtection %}

{% set pageHeading = "Record warrant return" %}

{% block page %}
  {{ govukSummaryList(evictionData) }}

  <form method="post" action="{{ formAction }}" novalidate>
    {{ csrfProtection(csrfToken) }}
    {{ govukSelect({
        id: "return-type",
        name: "return-type",
        label: {
          text: "Return"
        },
        items: warrantReturnTypeList,
        value: answers.returnType,
        errorMessage: validationErrors["return-type"]
      })
    }}

    <div id="final-outcome-section" class="govuk-checkboxes__conditional govuk-!-display-none">
      {{ govukSelect({
          id: "final-outcome",
          name: "final-outcome",
          label: {
            text: "Final outcome"
          },
          items: evictionOutcomeList,
          value: answers.finalOutcome,
          errorMessage: validationErrors["final-outcome"]
        })
      }}

      <div id="eviction-successful" class="govuk-checkboxes__conditional govuk-!-display-none">
        {{ govukSelect({
            id: "eviction-successful-return-name",
            name: "eviction-successful-return-name",
            label: {
              text: "Return name"
            },
            items: evictionSuccessfulReturnTypeList,
            value: answers.evictionSuccessfulReturnName,
            errorMessage: validationErrors["eviction-successful-return-name"]
          })
        }}
      </div>

      <div id="eviction-unsuccessful-cancelled" class="govuk-checkboxes__conditional govuk-!-display-none">
        {{ govukSelect({
            id: "eviction-unsuccessful-return-name",
            name: "eviction-unsuccessful-return-name",
            label: {
              text: "Return name"
            },
            items: evictionUnsuccessfulReturnTypeList,
            value: answers.evictionUnsuccessfulReturnName,
            errorMessage: validationErrors["eviction-unsuccessful-return-name"]
          })
        }}
      </div>
    </div>

    <div id="interim" class="govuk-checkboxes__conditional govuk-!-display-none">
      {{ govukSelect({
          id: "interim-return-name",
          name: "interim-return-name",
          label: {
            text: "Return name"
          },
          items: interimReturnTypeList,
          value: answers.interimReturnName,
          errorMessage: validationErrors["interim-return-name"]
        })
      }}
    </div>

      {{ dateInput(
            "eviction-date",
            "Eviction date and time",
            "For example, 27 3 2026 14 30. Use the 24-hour clock."
          )
      }}

    {{ govukCharacterCount({
        name: "additional-details",
        id: "additional-details",
        maxlength: additionalDetailsMaxLength,
        value: answers.additionalDetails,
        errorMessage: validationErrors["additional-details"],
        label: {
          text: "Additional details",
          classes: "",
          attributes: {
            id: "additional-details-label"
          }
        }
      })
    }}

    {{ buttons.eventButtons() }}
  </form>
{% endblock %}
