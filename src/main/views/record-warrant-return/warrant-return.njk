{% extends "record-warrant-return/_layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "macros/caseTitle.njk" import caseTitle %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/character-count/macro.njk" import govukCharacterCount %}
{% from "govuk/components/date-input/macro.njk" import govukDateInput %}
{% import "macros/xuiButtons.njk" as buttons with context %}
{% import "macros/dateTimeInput.njk" as dateTimeInput with context %}

{% block mainContent %}
  {{ govukSummaryList(evictionData) }}

  <form method="post" action="{{ formAction }}" novalidate>
    {{ govukSelect({
        id: "return-type",
        name: "return-type",
        label: {
          text: "Return"
        },
        items: warrantReturnTypeList
      })
     }}

    <div id="final-outcome" class="govuk-!-display-none">
      {{ govukSelect({
          id: "final-outcome",
          name: "final-outcome",
          label: {
            text: "Final outcome"
          },
          items: evictionOutcomeList
        })
      }}
    </div>

    <div id="eviction-successful" class="govuk-!-display-none">
      {{ govukSelect({
          id: "eviction-successful-return-name",
          name: "eviction-successful-return-name",
          label: {
            text: "Return name"
          },
          items: evictionSuccessfulReturnTypeList
        })
      }}

      {{
        dateTimeInput(
          "eviction-date",
          "Eviction date and time",
          "For example, 27 3 2026 14 30. Use the 24-hour clock."
        )
      }}
    </div>

    <div id="eviction-unsuccessful-cancelled" class="govuk-!-display-none">
      {{ govukSelect({
          id: "eviction-unsuccessful-return-name",
          name: "eviction-unsuccessful-return-name",
          label: {
            text: "Return name"
          },
          items: evictionUnsuccessfulReturnTypeList
        })
      }}
    </div>

    <div id="interim" class="govuk-!-display-none">
      {{ govukSelect({
          id: "interim-return-name",
          name: "interim-return-name",
          label: {
            text: "Return name"
          },
          items: interimReturnTypeList
        })
      }}
    </div>

    <div id="additional-details-mandatory" class="govuk-!-display-none">
      {{ govukCharacterCount({
          name: "additional-details-mandatory",
          id: "additional-details-mandatory",
          maxLength: 6800,
          label: {
            text: "Additional details"
          }
        })
      }}
    </div>

    <div id="additional-details-optional" class="govuk-!-display-none">
      {{ govukCharacterCount({
      name: "additional-details-mandatory",
          id: "additional-details-mandatory",
          maxLength: 6800,
          label: {
            text: "Additional details (Optional)"
          }
        })
      }}
    </div>

    {{ buttons.eventButtons() }}
  </form>
{% endblock %}
