{#
  Marker consumed by assets/js/redirect-on-back.ts.

  Legal representatives on a confirmation page (`redirectOnBack`) are sent to
  the Manage Case case summary (`closeUrl`) when they use the browser Back
  button. Gated by `release-1.4-enabled` (`release14Enabled`).
#}
{% if release14Enabled and isLegalRepresentative and redirectOnBack and closeUrl %}
  <span id="redirect-on-back" data-redirect-url="{{ closeUrl }}" hidden></span>
{% endif %}
