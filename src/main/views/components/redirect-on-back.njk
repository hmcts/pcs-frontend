{#
  Marker consumed by assets/js/redirect-on-back.ts.

  Citizens are sent to the case dashboard when `release-1.2-enabled` is on.
  Legal representatives are sent to the Manage Case case summary (`closeUrl`)
  when `release-1.4-enabled` is on.
#}
{% if isLegalRepresentative %}
  {% if release14Enabled and redirectOnBack and closeUrl %}
    <span id="redirect-on-back" data-redirect-url="{{ closeUrl }}" hidden></span>
  {% endif %}
{% elif release12Enabled and redirectOnBack and dashboardUrl %}
  <span id="redirect-on-back" data-dashboard-url="{{ dashboardUrl }}" hidden></span>
{% endif %}
