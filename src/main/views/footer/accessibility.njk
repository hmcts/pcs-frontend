{% extends "footer/layout.njk" %}

{% block pageTitle %}
  {{ t('footer/accessibility:pageTitle') }}
{% endblock %}

{% block mainContent %}
  <h1 class="govuk-heading-xl">{{ t('footer/accessibility:accessibilityStatement.title') }}</h1>
  <p class="govuk-body">{{ t('footer/accessibility:accessibilityStatement.description1') }}</p>
  <p class="govuk-body">{{ t('footer/accessibility:accessibilityStatement.description2') }}</p>
  <ul class="govuk-list govuk-list--bullet">
      <li>{{ t('footer/accessibility:accessibilityStatement.list.item1') }}</li>
      <li>{{ t('footer/accessibility:accessibilityStatement.list.item2') }}</li>
      <li>{{ t('footer/accessibility:accessibilityStatement.list.item3') }}</li>
      <li>{{ t('footer/accessibility:accessibilityStatement.list.item4') }}</li>
      <li>{{ t('footer/accessibility:accessibilityStatement.list.item5') }}</li>
  </ul>
  <p class="govuk-body">{{ t('footer/accessibility:accessibilityStatement.description3') }}</p>
  <p class="govuk-body">
    {{ t('footer/accessibility:accessibilityStatement.description4') | safe }}
  </p>

  <h2 class="govuk-heading-l">{{ t('footer/accessibility:enforcementProcedure.title') }}</h2>
  <p class="govuk-body">
    {{ t('footer/accessibility:enforcementProcedure.description1') | safe }}
  </p>

  <h2 class="govuk-heading-l">{{ t('footer/accessibility:feedbackAndContactInformation.title') }}</h2>
  <p class="govuk-body">{{ t('footer/accessibility:feedbackAndContactInformation.description1') }}</p>
  <ul class="govuk-list govuk-list--bullet">
