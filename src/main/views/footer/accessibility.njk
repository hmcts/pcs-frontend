  </ul>
  <p class="govuk-body">{{ t('footer/accessibility:feedbackAndContactInformation.description2') }}</p>

  <h2 class="govuk-heading-l">{{ t('footer/accessibility:technicalInformationAboutThisWebsitesAccessibility.title') }}</h2>
  <p class="govuk-body">{{ t('footer/accessibility:technicalInformationAboutThisWebsitesAccessibility.description1') }}</p>

  <h2 class="govuk-heading-l">{{ t('footer/accessibility:complianceStatus.title') }}</h2>
  <p class="govuk-body">{{ t('footer/accessibility:complianceStatus.description1') }}</p>

  <h2 class="govuk-heading-l">{{ t('footer/accessibility:non-accessibleContent.title') }}</h2>
  <p class="govuk-body">{{ t('footer/accessibility:non-accessibleContent.description1') }}</p>
  <ul class="govuk-list govuk-list--bullet">
      <li>{{ t('footer/accessibility:non-accessibleContent.list.item1') | safe }}</li>
