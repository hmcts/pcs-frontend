      <li>{{ t('footer/accessibility:non-accessibleContent.list.item3') | safe }}</li>
      <li>{{ t('footer/accessibility:non-accessibleContent.list.item4') | safe }}</li>
      <li>{{ t('footer/accessibility:non-accessibleContent.list.item5') | safe }}</li>
      <li>{{ t('footer/accessibility:non-accessibleContent.list.item6') | safe }}</li>
      <li>{{ t('footer/accessibility:non-accessibleContent.list.item7') | safe }}</li>
      <li>{{ t('footer/accessibility:non-accessibleContent.list.item8') | safe }}</li>
      <li>{{ t('footer/accessibility:non-accessibleContent.list.item9') | safe }}</li>
      <li>{{ t('footer/accessibility:non-accessibleContent.list.item10') | safe }}</li>
  </ul>

  <h2 class="govuk-heading-l">{{ t('footer/accessibility:whatWeAreDoingToImproveAccessibility.title') }}</h2>
  <p class="govuk-body">{{ t('footer/accessibility:whatWeAreDoingToImproveAccessibility.description1') }}</p>
   <p class="govuk-body">{{ t('footer/accessibility:whatWeAreDoingToImproveAccessibility.description2') }}</p>
   <p class="govuk-body">{{ t('footer/accessibility:whatWeAreDoingToImproveAccessibility.description3') }}</p>

  <h2 class="govuk-heading-l">{{ t('footer/accessibility:preparationOfThisAccessibilityStatement.title') }}</h2>
  <p class="govuk-body">{{ t('footer/accessibility:preparationOfThisAccessibilityStatement.description1') }}</p>
  <p class="govuk-body">
   {{ t('footer/accessibility:preparationOfThisAccessibilityStatement.description2') | safe }}
  </p>
  
