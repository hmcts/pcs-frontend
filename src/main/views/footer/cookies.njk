{% extends "footer/layout.njk" %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageTitle %}
  {{ t('footer/cookies:pageTitle') }}
{% endblock %}

{% block mainContent %}
  <h1 id="cookies" class="govuk-heading-xl">{{ t('footer/cookies:cookies.title') }}</h1>
  <p class="govuk-body">{{ t('footer/cookies:cookies.description1') }}</p>
  <p class="govuk-body">{{ t('footer/cookies:cookies.description2') }}</p>
  <ul class="govuk-list govuk-list--bullet">
      <li>{{ t('footer/cookies:cookies.list.item1') }}</li>
      <li>{{ t('footer/cookies:cookies.list.item2') }}</li>
      <li>{{ t('footer/cookies:cookies.list.item3') }}</li>
  </ul>
  <p class="govuk-body">{{ t('footer/cookies:cookies.description3') | safe }}</p>
  <h2 id="how-cookies-are-used-in-this-service" class="govuk-heading-l">{{ t('footer/cookies:howCookiesAreUsedInThisService.title') }}</h2>
  <p class="govuk-body">{{ t('footer/cookies:howCookiesAreUsedInThisService.description1') }}</p>
  <table class="govuk-table">
      <thead class="govuk-table__head">
          <tr class="govuk-table__row">
              <th scope="col" class="govuk-table__header">{{ t('footer/cookies:cookieTable.header.name') }}</th>
              <th scope="col" class="govuk-table__header">{{ t('footer/cookies:cookieTable.header.purpose') }}</th>
              <th scope="col" class="govuk-table__header">{{ t('footer/cookies:cookieTable.header.expires') }}</th>
          </tr>
      </thead>
      <tbody>
         <tr scope="col" class="govuk-table__row">
              <td class="govuk-table__cell">{{ t('footer/cookies:cookieTable.row1.name') }}</td>
              <td class="govuk-table__cell">{{ t('footer/cookies:cookieTable.row1.purpose') }}</td>
              <td class="govuk-table__cell">{{ t('footer/cookies:cookieTable.row1.expires') }}</td>
          </tr>
          <tr scope="col" class="govuk-table__row">
              <td class="govuk-table__cell">{{ t('footer/cookies:cookieTable.row2.name') }}</td>
              <td class="govuk-table__cell">{{ t('footer/cookies:cookieTable.row2.purpose') }}</td>
              <td class="govuk-table__cell">{{ t('footer/cookies:cookieTable.row2.expires') }}</td>
          </tr>
          <tr scope="col" class="govuk-table__row">
              <td class="govuk-table__cell">{{ t('footer/cookies:cookieTable.row3.name') }}</td>
              <td class="govuk-table__cell">{{ t('footer/cookies:cookieTable.row3.purpose') }}</td>
              <td class="govuk-table__cell">{{ t('footer/cookies:cookieTable.row3.expires') }}</td>
          </tr>
          <tr scope="col" class="govuk-table__row">
              <td class="govuk-table__cell">{{ t('footer/cookies:cookieTable.row4.name') }}</td>
              <td class="govuk-table__cell">{{ t('footer/cookies:cookieTable.row4.purpose') }}</td>
              <td class="govuk-table__cell">{{ t('footer/cookies:cookieTable.row4.expires') }}</td>
          </tr>
          <tr scope="col" class="govuk-table__row">
              <td class="govuk-table__cell">{{ t('footer/cookies:cookieTable.row5.name') }}</td>
              <td class="govuk-table__cell">{{ t('footer/cookies:cookieTable.row5.purpose') }}</td>
              <td class="govuk-table__cell">{{ t('footer/cookies:cookieTable.row5.expires') }}</td>
          </tr>
          <tr scope="col" class="govuk-table__row">
              <td class="govuk-table__cell">{{ t('footer/cookies:cookieTable.row6.name') }}</td>
              <td class="govuk-table__cell">{{ t('footer/cookies:cookieTable.row6.purpose') }}</td>
              <td class="govuk-table__cell">{{ t('footer/cookies:cookieTable.row6.expires') }}</td>
          </tr>
          <tr scope="col" class="govuk-table__row">
              <td class="govuk-table__cell">{{ t('footer/cookies:cookieTable.row7.name') }}</td>
              <td class="govuk-table__cell">{{ t('footer/cookies:cookieTable.row7.purpose') }}</td>
              <td class="govuk-table__cell">{{ t('footer/cookies:cookieTable.row7.expires') }}</td>
          </tr>
          <tr scope="col" class="govuk-table__row">
              <td class="govuk-table__cell">{{ t('footer/cookies:cookieTable.row8.name') }}</td>
              <td class="govuk-table__cell">{{ t('footer/cookies:cookieTable.row8.purpose') }}</td>
              <td class="govuk-table__cell">{{ t('footer/cookies:cookieTable.row8.expires') }}</td>
          </tr>
          {% if tracking and tracking.enabled %}
          {% for row in ['preferences', 'ga', 'gaContainer'] %}
          <tr class="govuk-table__row">
              <td class="govuk-table__cell">{{ t('footer/cookies:trackingCookieTable.' + row + '.name') }}</td>
              <td class="govuk-table__cell">{{ t('footer/cookies:trackingCookieTable.' + row + '.purpose') }}</td>
              <td class="govuk-table__cell">{{ t('footer/cookies:trackingCookieTable.' + row + '.expires') }}</td>
          </tr>
          {% endfor %}
          {% endif %}
      </tbody>
  </table>
  {% if tracking and tracking.enabled %}
  <h2 id="cookie-settings" class="govuk-heading-l">{{ t('footer/cookies:cookieSettings.title') }}</h2>
  <form class="cookie-preferences-form">
    {{ govukRadios({
      classes: 'govuk-radios',
      idPrefix: 'analytics',
      name: 'analytics',
      fieldset: {
        legend: {
          text: t('footer/cookies:cookiePage.analytics.legend'),
          classes: "govuk-fieldset__legend--s"
        }
      },
      items: [
        {
          value: 'on',
          text: t('footer/cookies:cookiePage.analytics.items.on')
        },
        {
          value: 'off',
          text: t('footer/cookies:cookiePage.analytics.items.off'),
          checked: true
        }
      ]
    }) }}

    {{ govukRadios({
      classes: 'govuk-radios',
      idPrefix: 'apm',
      name: 'apm',
      fieldset: {
        legend: {
          text: t('footer/cookies:cookiePage.apm.legend'),
          classes: "govuk-fieldset__legend--s"
        }
      },
      items: [
        {
          value: 'on',
          text: t('footer/cookies:cookiePage.apm.items.on')
        },
        {
          value: 'off',
          text: t('footer/cookies:cookiePage.apm.items.off'),
          checked: true
        }
      ]
    }) }}

    {{ govukButton({
      text: t('footer/cookies:cookiePage.submit')
    }) }}
  </form>
  {% endif %}
{% endblock %}
