{% extends "xui-layout.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "macros/csrf.njk" import csrfProtection %}
{% import "make-order/_compact.njk" as compact with context %}

{% set htmlClasses = "pcs-make-order" %}

{% set pageHeading = "Make an order" %}

{% block content %}
  {% if errorSummary %}
    {{ govukErrorSummary(errorSummary) }}
  {% endif %}

  {# The explicit action leaves out the tab fragment, so a refused submission opens at the error summary. #}
  <form method="post" action="{{ formAction }}" novalidate id="make-order-form"
        data-property-address="{{ propertyAddressDisplay }}"
        data-parties="{{ orderParties | dump }}"
        {%- if withoutHearing %} data-without-hearing{% endif %}>
  <input type="hidden" name="eventToken" value="{{ eventToken }}">
  <input type="hidden" name="orderId" value="{{ order.id }}">
  <input type="hidden" name="taskId" value="{{ taskId }}">
  <input type="hidden" name="orderVersion" value="{{ order.version }}">
  <input type="hidden" name="hearingVersion" value="{{ hearingVersion }}">
  {{ csrfProtection(csrfToken) }}
  {#
    A form's first button is the one pressing Enter in a field uses: this keeps that sending the order, as the page's
    own send button does, rather than the button for changing when the order is made, which comes first on the page.
  #}
  <button type="submit" name="action" value="SUBMIT_FOR_REVIEW" class="govuk-visually-hidden" tabindex="-1"
          aria-hidden="true" data-enter-key-default>Send order to caseworker for review</button>

  <h1 class="govuk-heading-xl govuk-!-margin-bottom-2">{{ pageHeading }}</h1>

  <p class="govuk-body govuk-!-margin-bottom-1">
    <span class="govuk-!-font-weight-bold">Case reference:</span> {{ caseReferenceDisplay }}
  </p>
  <p class="govuk-body govuk-!-margin-bottom-1">{{ propertyAddressDisplay }}</p>
  <p class="govuk-body govuk-!-font-weight-bold">
    {{ claimantNames }} vs {{ defendantNames }}
  </p>

  {% include "make-order/_whole-file.njk" %}


  {% if order.queryFromCaseworker %}
    {# An order a caseworker returned: their query. #}
    <h2 class="govuk-heading-m">Query from the caseworker</h2>
    <p class="govuk-body">
      A caseworker returned this order to you with a query. Change the order if you need to, then send it for review again.
    </p>
    {{ govukInsetText({
      html: '<p class="govuk-body pcs-preserve-lines">' + (order.queryFromCaseworker | escape) + '</p>',
      attributes: { id: "caseworker-query" }
    }) }}
  {% endif %}

  {#
    The judge says when the order is made, whatever task or link brought them here: without a hearing, or at one of the
    case's hearings, which brings up who attended and the hearing's facts and notes. Changing it shows the page again
    with everything the judge has written so far, and saves nothing.
  #}
  <h2 class="govuk-heading-l govuk-!-margin-top-6">When the order is made</h2>
  <input type="hidden" name="shown-made-at" value="{{ madeAt }}">
  {{ govukRadios({
    idPrefix: "made-at",
    name: "made-at",
    classes: "govuk-radios--small",
    fieldset: { legend: { text: "Is this order made at a hearing?", classes: "govuk-fieldset__legend--s" } },
    hint: { text: "Choose a hearing to record who attended and the case facts and notes for it." },
    items: madeAtItems,
    errorMessage: validationErrors["made-at"]
  }) }}
  {{ govukButton({
    text: "Change when the order is made",
    name: "action",
    value: "CHANGE_MADE_AT",
    classes: "govuk-button--secondary",
    attributes: { id: "change-made-at" }
  }) }}

  {% include "make-order/_form.njk" %}

  {{ compact.reveal("staff-message", "Staff message", compact.textarea("staff-message-text", { label: "Message for court staff" })) }}

  <div class="govuk-button-group govuk-!-margin-top-6">
    {{ govukButton({
      text: "Send order to caseworker for review",
      name: "action",
      value: "SUBMIT_FOR_REVIEW",
      preventDoubleClick: true,
      attributes: { id: "submit-order-for-review" }
    }) }}
    {{ govukButton({
      text: "Save as draft",
      name: "action",
      value: "SAVE_DRAFT",
      preventDoubleClick: true,
      classes: "govuk-button--secondary"
    }) }}
  </div>

  </form>
{% endblock %}
