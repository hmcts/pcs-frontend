{% extends "template.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/date-input/macro.njk" import govukDateInput %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/textarea/macro.njk" import govukTextarea %}
{% from "xui-header/macro.njk" import hmctsXuiHeader %}
{% from "footer/macro.njk" import hmctsUiFooter %}

{# Judicial screen: full-bleed container instead of the 1020px citizen measure. #}
{% set containerClasses = "pcs-wide" %}

{# Keeps keyboard focus clear of the sticky case-facts panel — see make-order.scss. #}
{% set htmlClasses = "pcs-make-order" %}

{% block pageTitle %}
  Make an order - HM Courts &amp; Tribunals Service &ndash; GOV.UK
{% endblock %}

{#
  This page is judges only, so it always uses the xui chrome judges already work in — there is no
  citizen variant to fall back to, and so no conditional. Other pages in this app serve both
  audiences and branch on isLegalRepresentative; this one does not.
#}
{% block head %}
  {{ super() }}
  <link rel="stylesheet" href="/assets/ui-component-lib/ui-component-lib.css">
{% endblock %}

{% block header %}
  {{ hmctsXuiHeader(headerModel) }}
{% endblock %}

{#
  The xui header brings its own navigation and beta banner, and this page is English only, so
  everything template.njk puts above the content is dropped rather than duplicated. No back link
  either: this is a single page, not a step in a journey.
#}
{% block beforeContent %}{% endblock %}

{% block footer %}
  {{ hmctsUiFooter(footerModel) }}
{% endblock %}

{#
  Iteration 1 is a static shell: no data is populated, nothing is posted, and there is no
  client-side JavaScript beyond stock govuk-frontend (tabs and conditional reveals).
  Placeholder values below are illustrative only.
#}

{% set tenancyTypes = [
  { value: "assured", text: "Assured" },
  { value: "assured-shorthold", text: "Assured shorthold" },
  { value: "regulated", text: "Regulated" },
  { value: "secure", text: "Secure" },
  { value: "other", text: "Other" }
] %}

{% set rentFrequencies = [
  { value: "weekly", text: "Weekly" },
  { value: "fortnightly", text: "Fortnightly" },
  { value: "monthly", text: "Monthly" },
  { value: "yearly", text: "Yearly" }
] %}

{# Payment plans offer only these two, unlike the rent frequency above. #}
{% set paymentFrequencies = [
  { value: "weekly", text: "Weekly" },
  { value: "monthly", text: "Monthly" }
] %}

{#
  Attendance shorthand is kept for scanning density, with the full term in a visually hidden
  span so assistive technology announces something unambiguous.
#}
{% set claimantAttendance = [
  { value: "counsel", short: "Csl", full: "Counsel" },
  { value: "solicitor", short: "Sol", full: "Solicitor" },
  { value: "solicitor-agent", short: "S/A", full: "Solicitor agent" },
  { value: "housing-officer", short: "H/O", full: "Housing officer" },
  { value: "litigant-in-person", short: "LiP", full: "Litigant in person" },
  { value: "letter-only", short: "Ltr", full: "Letter only" },
  { value: "not-present", short: "Not present", full: "" }
] %}

{% set defendantAttendance = [
  { value: "counsel", short: "Csl", full: "Counsel" },
  { value: "solicitor", short: "Sol", full: "Solicitor" },
  { value: "solicitor-agent", short: "S/A", full: "Solicitor agent" },
  { value: "duty-adviser", short: "Duty", full: "Duty adviser" },
  { value: "litigant-in-person", short: "LiP", full: "Litigant in person" },
  { value: "letter-only", short: "Ltr", full: "Letter only" },
  { value: "not-present", short: "Not present", full: "" }
] %}

{% set attendanceParties = [
  { id: "claimant-1", label: "Claimant 1: Bristol City Housing", options: claimantAttendance },
  { id: "defendant-1", label: "Defendant 1: David Patel", options: defendantAttendance },
  { id: "defendant-2", label: "Defendant 2: Fatima Jones", options: defendantAttendance },
  { id: "defendant-3", label: "Defendant 3: Andrew Taylor", options: defendantAttendance },
  { id: "defendant-4", label: "Defendant 4: Rachel Smith", options: defendantAttendance }
] %}

{% block content %}
  <h1 class="govuk-heading-xl govuk-!-margin-bottom-2">Make an order</h1>

  <p class="govuk-body govuk-!-margin-bottom-1">
    <span class="govuk-!-font-weight-bold">Case reference:</span> 1777-0276-0001-7760
  </p>
  <p class="govuk-body govuk-!-margin-bottom-1">22 Victoria Road, Birmingham, Bristol, NN1 2AB</p>
  <p class="govuk-body govuk-!-font-weight-bold">
    Bristol City Housing vs David Patel, Fatima Jones, Andrew Taylor, Rachel Smith
  </p>

  {#
    Case facts stay pinned while the judge drafts below. Each date is a govukDateInput so the
    day/month/year inputs are grouped in a fieldset and announced with the field name.
  #}
  <section class="pcs-case-facts" aria-labelledby="case-facts-heading">
    <h2 class="govuk-heading-s govuk-!-margin-bottom-2" id="case-facts-heading">
      Case facts (tenancy/contract)
    </h2>

    <div class="pcs-case-facts__layout">
      <div class="pcs-case-facts__grid">
        {{ govukDateInput({
          id: "date-tenancy",
          namePrefix: "date-tenancy",
          fieldset: { legend: { text: "Date of tenancy/contract", classes: "govuk-fieldset__legend--s" } }
        }) }}

        {{ govukSelect({
          id: "tenancy-type",
          name: "tenancy-type",
          label: { text: "Tenancy/contract type", classes: "govuk-label--s" },
          items: tenancyTypes
        }) }}

        {{ govukDateInput({
          id: "date-notice",
          namePrefix: "date-notice",
          fieldset: { legend: { text: "Date of service of notice", classes: "govuk-fieldset__legend--s" } }
        }) }}

        {{ govukInput({
          id: "arrears-notice",
          name: "arrears-notice",
          label: { text: "Arrears at notice", classes: "govuk-label--s" },
          classes: "govuk-input--width-5",
          spellcheck: false,
          prefix: { text: "£" }
        }) }}

        {{ govukInput({
          id: "current-rent",
          name: "current-rent",
          label: { text: "Current rent", classes: "govuk-label--s" },
          classes: "govuk-input--width-5",
          spellcheck: false,
          prefix: { text: "£" }
        }) }}

        {{ govukSelect({
          id: "rent-frequency",
          name: "rent-frequency",
          label: { text: "Rent frequency", classes: "govuk-label--s" },
          items: rentFrequencies
        }) }}

        {{ govukInput({
          id: "grounds-pleaded",
          name: "grounds-pleaded",
          label: { text: "Grounds pleaded", classes: "govuk-label--s" },
          classes: "govuk-input--width-10"
        }) }}

        {{ govukInput({
          id: "arrears-issue",
          name: "arrears-issue",
          label: { text: "Arrears on issue", classes: "govuk-label--s" },
          classes: "govuk-input--width-5",
          spellcheck: false,
          prefix: { text: "£" }
        }) }}

        {{ govukDateInput({
          id: "date-last-hearing",
          namePrefix: "date-last-hearing",
          fieldset: { legend: { text: "Date of last hearing", classes: "govuk-fieldset__legend--s" } }
        }) }}

        {{ govukDateInput({
          id: "date-last-payment",
          namePrefix: "date-last-payment",
          fieldset: { legend: { text: "Date last payment made", classes: "govuk-fieldset__legend--s" } }
        }) }}

        {{ govukInput({
          id: "last-payment",
          name: "last-payment",
          label: { text: "Last payment", classes: "govuk-label--s" },
          classes: "govuk-input--width-5",
          spellcheck: false,
          prefix: { text: "£" }
        }) }}

        {{ govukInput({
          id: "arrears-today",
          name: "arrears-today",
          label: { text: "Arrears today", classes: "govuk-label--s" },
          classes: "govuk-input--width-5",
          spellcheck: false,
          prefix: { text: "£" }
        }) }}
      </div>

      {{ govukTextarea({
        id: "hearing-notes",
        name: "hearing-notes",
        rows: 8,
        label: { text: "Hearing notes (internal use only)", classes: "govuk-label--s" },
        formGroup: { classes: "govuk-!-margin-bottom-0" }
      }) }}
    </div>
  </section>

  <h2 class="govuk-heading-l govuk-!-margin-top-6">Attendance</h2>

  {% for party in attendanceParties %}
    {#
      role="group" + aria-labelledby rather than fieldset/legend, which is what the rest of this
      page uses. A fieldset's rendered legend is laid out outside the box holding its other
      children, so it cannot sit in a grid column beside them — it always takes a line of its own,
      which is what doubles the height of this section. The usual workarounds (floating the legend,
      or display: contents on the fieldset) both rely on browser behaviour that is inconsistent in
      the accessibility tree, and the float demonstrably dropped the grouping here.

      role="group" is the ARIA equivalent of fieldset and carries no layout special-casing, so the
      party name can simply be the first grid column. The grouping is explicit and verifiable.
    #}
    <div class="pcs-attendance__row" role="group" aria-labelledby="{{ party.id }}-label">
      <span class="govuk-label govuk-label--s pcs-attendance__label" id="{{ party.id }}-label">
        {{ party.label }}
      </span>

      <div class="govuk-radios govuk-radios--small govuk-radios--inline" data-module="govuk-radios">
        {% for option in party.options %}
          <div class="govuk-radios__item">
            <input class="govuk-radios__input"
                   id="{{ party.id }}-{{ option.value }}"
                   name="{{ party.id }}-attendance"
                   type="radio"
                   value="{{ option.value }}">
            {#
              Sighted judges scan the abbreviations; assistive technology gets the full term
              instead. abbr/title is deliberately avoided — screen reader support for title
              is inconsistent.
            #}
            <label class="govuk-label govuk-radios__label" for="{{ party.id }}-{{ option.value }}">
              {%- if option.full -%}
                <span aria-hidden="true">{{ option.short }}</span>
                <span class="govuk-visually-hidden">{{ option.full }}</span>
              {%- else -%}
                {{ option.short }}
              {%- endif -%}
            </label>
          </div>
        {% endfor %}
      </div>

      {#
        "Name:" is visible, beside the box rather than above it — see make-order.scss. The rest of
        the label is visually hidden, so the accessible name stays "Name of representative for
        Claimant 1: ..." and each of the five boxes is unambiguous when reached out of context,
        while a sighted judge reads the short version the column already implies.

        The colon is aria-hidden for the same reason the attendance abbreviations are: it separates
        the label from its field visually and is not part of the field's name.
      #}
      {{ govukInput({
        id: party.id + "-name",
        name: party.id + "-name",
        label: {
          html: 'Name<span aria-hidden="true">:</span><span class="govuk-visually-hidden"> of representative for ' + (party.label | escape) + '</span>',
          classes: "pcs-attendance__name-label"
        },
        classes: "govuk-input--width-20"
      }) }}
    </div>
  {% endfor %}

  <h2 class="govuk-heading-l govuk-!-margin-top-6">Recitals</h2>

  {{ govukCheckboxes({
    idPrefix: "recitals",
    name: "recitals",
    classes: "govuk-checkboxes--small",
    items: [{
      value: "yes",
      text: "Recitals",
      conditional: {
        html: govukTextarea({
          id: "recitals-text",
          name: "recital",
          rows: 4,
          label: { text: "Recital paragraphs" }
        })
      }
    }]
  }) }}

  <h2 class="govuk-heading-l govuk-!-margin-top-6">Order type</h2>

  {#
    Tabs are hand-written rather than built through the govukTabs macro so each panel can hold
    real markup instead of a pre-rendered HTML string. This is the markup govuk-frontend's Tabs
    component expects; behaviour comes from data-module="govuk-tabs".
  #}
  <div class="govuk-tabs" data-module="govuk-tabs">
    <h3 class="govuk-tabs__title">Contents</h3>
    <ul class="govuk-tabs__list">
      <li class="govuk-tabs__list-item govuk-tabs__list-item--selected">
        <a class="govuk-tabs__tab" href="#tab-outright">Outright possession</a>
      </li>
      <li class="govuk-tabs__list-item">
        <a class="govuk-tabs__tab" href="#tab-suspended">Suspended possession</a>
      </li>
      <li class="govuk-tabs__list-item">
        <a class="govuk-tabs__tab" href="#tab-adjournment">Adjournment</a>
      </li>
      <li class="govuk-tabs__list-item">
        <a class="govuk-tabs__tab" href="#tab-strike-out">Strike out/dismiss</a>
      </li>
      <li class="govuk-tabs__list-item">
        <a class="govuk-tabs__tab" href="#tab-free-form">Free form</a>
      </li>
    </ul>

    <div class="govuk-tabs__panel" id="tab-outright">
      <h3 class="govuk-heading-m">Outright possession</h3>

      {{ govukRadios({
        name: "outright-possession",
        classes: "govuk-radios--small",
        fieldset: { legend: { text: "Possession", classes: "govuk-fieldset__legend--s" } },
        items: [
          { value: "forthwith", text: "Possession forthwith" },
          {
            value: "by",
            text: "Possession on or before",
            conditional: {
              html: govukDateInput({
                id: "outright-by-date",
                namePrefix: "outright-by-date",
                fieldset: { legend: { text: "Date possession is ordered by", classes: "govuk-visually-hidden" } }
              })
            }
          }
        ]
      }) }}

      {{ govukRadios({
        name: "outright-grounds-type",
        classes: "govuk-radios--small govuk-radios--inline",
        fieldset: { legend: { text: "Grounds", classes: "govuk-fieldset__legend--s" } },
        items: [
          { value: "mandatory", text: "Mandatory" },
          { value: "discretionary", text: "Discretionary" }
        ]
      }) }}

      {#
        This field qualifies the Grounds radios above rather than asking anything new, so it is
        marked as a continuation and no dividing rule is drawn between the two — see make-order.scss.
      #}
      {{ govukInput({
        id: "outright-grounds-details",
        name: "outright-grounds-details",
        label: { text: "Details of grounds (optional)" },
        classes: "govuk-input--width-20",
        formGroup: { classes: "pcs-continues-question" }
      }) }}

      {#
        Money judgment. The prototype nests conditional reveals four deep here — money judgment
        reveals "judgment for arrears", which reveals "must be paid by", which reveals the payment
        plan, which reveals the balance date. Flattened to one level: the sums and the payment terms
        are shown together once money judgment is ticked.

        Nesting reveals is not a pattern govuk-frontend supports, and the deeper levels are the
        reason: a judge tabbing through has no way to know that ticking one box has grown three more
        levels somewhere below, and each level indents further until the fields are off to the right
        of the panel. Everything here is optional, so nothing is lost by showing it at once.
      #}
      {% set outrightMoneyJudgmentHtml %}
        {# The two sums are one row, as in the prototype, rather than a field and then a field. #}
        <div class="pcs-inline-fields">
          {{ govukInput({
            id: "outright-mj-arrears",
            name: "outright-mj-arrears",
            label: { text: "Judgment for arrears" },
            classes: "govuk-input--width-5",
            spellcheck: false,
            inputmode: "numeric",
            prefix: { text: "£" }
          }) }}

          {{ govukInput({
            id: "outright-mj-interest",
            name: "outright-mj-interest",
            label: { text: "Interest" },
            classes: "govuk-input--width-5",
            spellcheck: false,
            inputmode: "numeric",
            prefix: { text: "£" }
          }) }}
        </div>

        {#
          Checkboxes sharing one name, as the prototype has them — a lump sum and instalments can
          both apply to the same debt (a payment now, the rest over time), so this is two options
          rather than one choice. Same construct as the suspended tab's payment terms; the reasoning
          is written out there.
        #}
        {{ govukCheckboxes({
          idPrefix: "outright-mj-plan",
          name: "outright-mj-plan",
          classes: "govuk-checkboxes--small",
          fieldset: { legend: { text: "The above sums must be paid by", classes: "govuk-fieldset__legend--s" } },
          items: [
            {
              value: "lump",
              text: "Payment to claimant",
              conditional: {
                html: '<div class="pcs-inline-fields">' + govukInput({
                  id: "outright-mj-lump-amount",
                  name: "outright-mj-lump-amount",
                  label: { text: "Payment of" },
                  classes: "govuk-input--width-5",
                  spellcheck: false,
                  inputmode: "numeric",
                  prefix: { text: "£" }
                }) + govukDateInput({
                  id: "outright-mj-lump-date",
                  namePrefix: "outright-mj-lump-date",
                  fieldset: { legend: { text: "To be paid by", classes: "govuk-fieldset__legend--s" } }
                }) + govukDateInput({
                  id: "outright-mj-balance-date",
                  namePrefix: "outright-mj-balance-date",
                  fieldset: { legend: { text: "And the balance by (optional)", classes: "govuk-fieldset__legend--s" } }
                }) + '</div>'
              }
            },
            {
              value: "instalments",
              text: "Instalment payments",
              conditional: {
                html: '<div class="pcs-inline-fields">' + govukInput({
                  id: "outright-mj-inst-amount",
                  name: "outright-mj-inst-amount",
                  label: { text: "Instalment payments of" },
                  classes: "govuk-input--width-5",
                  spellcheck: false,
                  inputmode: "numeric",
                  prefix: { text: "£" }
                }) + govukSelect({
                  id: "outright-mj-inst-freq",
                  name: "outright-mj-inst-freq",
                  label: { text: "How often" },
                  items: paymentFrequencies
                }) + govukDateInput({
                  id: "outright-mj-inst-date",
                  namePrefix: "outright-mj-inst-date",
                  fieldset: { legend: { text: "First instalment to be paid on or before", classes: "govuk-fieldset__legend--s" } }
                }) + '</div>'
              }
            }
          ]
        }) }}
      {% endset %}

      {{ govukCheckboxes({
        idPrefix: "outright-options",
        name: "outright-options",
        classes: "govuk-checkboxes--small",
        items: [
          {
            value: "money-judgment",
            text: "Money judgment",
            conditional: { html: outrightMoneyJudgmentHtml }
          },
          {
            value: "use-occupation",
            text: "Damages for unlawful occupation",
            conditional: {
              html: '<div class="pcs-inline-fields">' + govukInput({
                id: "outright-use-occupation-rate",
                name: "outright-use-occupation-rate",
                label: { text: "Daily rate" },
                classes: "govuk-input--width-5",
                spellcheck: false,
                inputmode: "decimal",
                prefix: { text: "£" }
              }) + govukDateInput({
                id: "outright-use-occupation-from-date",
                namePrefix: "outright-use-occupation-from-date",
                fieldset: { legend: { text: "From", classes: "govuk-fieldset__legend--s" } }
              }) + '</div>'
            }
          },
          {
            value: "transfer-high-court",
            text: "Transfer to High Court"
          }
        ]
      }) }}
    </div>

    <div class="govuk-tabs__panel govuk-tabs__panel--hidden" id="tab-suspended">
      <h3 class="govuk-heading-m">Suspended possession</h3>

      {{ govukDateInput({
        id: "suspended-by-date",
        namePrefix: "suspended-by-date",
        fieldset: { legend: { text: "Possession by", classes: "govuk-fieldset__legend--s" } }
      }) }}

      {#
        The prototype's label for this is the sentence "Suspended on condition of payment of current
        rent plus arrears of ... to be paid by", split across two <span>s with the input in the
        middle and the trailing half left dangling with nothing after it — the "by" is answered by
        the payment terms below, which are a separate question, so as a label it never finishes.

        The label is what the field holds; the condition it forms part of goes in a hint, worded as
        the generated order words it ("suspended as long as the defendant pays (i) the rent as it
        falls due plus (ii) the arrears of £X"). That keeps the whole term on screen without a
        two-line bold label above a five-character box.
      #}
      {{ govukInput({
        id: "suspended-arrears",
        name: "suspended-arrears",
        label: { text: "Arrears to be paid", classes: "govuk-label--s" },
        hint: { text: "Possession is suspended as long as the defendant pays the current rent as it falls due, plus these arrears." },
        classes: "govuk-input--width-5",
        spellcheck: false,
        inputmode: "numeric",
        prefix: { text: "£" }
      }) }}

      {#
        Checkboxes, not radios: both can apply to the same arrears. The prototype's order preview
        renders a single payment of £12 by one date *and* £32 a month from another against one
        figure of arrears, as sub-paragraphs (a) and (b) of the same suspension term — so a lump sum
        followed by instalments is a real order and this is two independent options rather than one
        choice. That also means there is no "no payment terms" option to add: leaving both unticked
        already says it.

        Each option's fields sit on one row rather than stacked — see `pcs-inline-fields` in
        make-order.scss.
      #}
      {{ govukCheckboxes({
        idPrefix: "suspended-payment-terms",
        name: "suspended-payment-terms",
        classes: "govuk-checkboxes--small",
        fieldset: { legend: { text: "Arrears to be paid by", classes: "govuk-fieldset__legend--s" } },
        items: [
          {
            value: "one-off",
            text: "A single payment",
            conditional: {
              html: '<div class="pcs-inline-fields">' + govukInput({
                id: "suspended-oneoff-amount",
                name: "suspended-oneoff-amount",
                label: { text: "Payment of" },
                classes: "govuk-input--width-5",
                spellcheck: false,
                inputmode: "numeric",
                prefix: { text: "£" }
              }) + govukDateInput({
                id: "suspended-oneoff-date",
                namePrefix: "suspended-oneoff-date",
                fieldset: { legend: { text: "On or before", classes: "govuk-fieldset__legend--s" } }
              }) + '</div>'
            }
          },
          {
            value: "instalments",
            text: "Instalment payments",
            conditional: {
              html: '<div class="pcs-inline-fields">' + govukInput({
                id: "suspended-instalment-amount",
                name: "suspended-instalment-amount",
                label: { text: "Payments of" },
                classes: "govuk-input--width-5",
                spellcheck: false,
                inputmode: "numeric",
                prefix: { text: "£" }
              }) + govukSelect({
                id: "suspended-instalment-frequency",
                name: "suspended-instalment-frequency",
                label: { text: "How often" },
                items: paymentFrequencies
              }) + govukDateInput({
                id: "suspended-instalment-date",
                namePrefix: "suspended-instalment-date",
                fieldset: { legend: { text: "First payment by", classes: "govuk-fieldset__legend--s" } }
              }) + '</div>'
            }
          }
        ]
      }) }}

      {#
        "Suspended on the same terms as above" only makes sense once there is a money judgment for it
        to suspend, so the prototype ships it `disabled` and its script enables it when "Money
        judgment for the arrears above" is ticked. Here it is a reveal on that option instead, which
        is the same dependency expressed in markup rather than in script: no field, then the field —
        rather than a field that is visible but unusable and gives no reason why.

        A disabled control is also not announced as available and cannot be reached by keyboard, so
        without the script there is nothing to tell a judge what would unlock it. This page has no
        script yet, which is exactly why it cannot be copied as-is.
      #}
      {% set suspendedSameTermsHtml %}
        {{ govukCheckboxes({
          idPrefix: "suspended-mj-same-terms",
          name: "suspended-mj-same-terms",
          classes: "govuk-checkboxes--small",
          items: [{ value: "yes", text: "Suspended on the same terms as above" }]
        }) }}
      {% endset %}

      {{ govukCheckboxes({
        idPrefix: "suspended-options",
        name: "suspended-options",
        classes: "govuk-checkboxes--small",
        items: [
          {
            value: "money-judgment-arrears",
            text: "Money judgment for the arrears above",
            conditional: { html: suspendedSameTermsHtml }
          },
          { value: "money-claim-adjourned", text: "Money claim adjourned generally with liberty to restore" },
          {
            value: "use-occupation",
            text: "Damages for unlawful occupation",
            conditional: {
              html: '<div class="pcs-inline-fields">' + govukInput({
                id: "suspended-use-occupation-rate",
                name: "suspended-use-occupation-rate",
                label: { text: "Daily rate" },
                classes: "govuk-input--width-5",
                spellcheck: false,
                inputmode: "decimal",
                prefix: { text: "£" }
              }) + govukDateInput({
                id: "suspended-use-occupation-from-date",
                namePrefix: "suspended-use-occupation-from-date",
                fieldset: { legend: { text: "From", classes: "govuk-fieldset__legend--s" } }
              }) + '</div>'
            }
          },
          {
            value: "warrant-on-notice",
            text: "Any application for a warrant of eviction must be made and heard on notice to all parties unless the court orders otherwise"
          },
          { value: "transfer-high-court", text: "Transfer to High Court" }
        ]
      }) }}
    </div>

    <div class="govuk-tabs__panel govuk-tabs__panel--hidden" id="tab-adjournment">
      <h3 class="govuk-heading-m">Adjournment</h3>

      {#
        Adjourned for further hearing: when the next hearing is, how long it needs, in what format,
        and what each party must file before it.
      #}
      {% set adjournFurtherHearingHtml %}
        {#
          One date, whichever option is chosen, so the three options are radios and the date is a
          single field below them rather than the prototype's three separate date triples — one per
          radio, of which at most one can ever be filled in.
        #}
        {{ govukRadios({
          idPrefix: "adj-when",
          name: "adj-when",
          classes: "govuk-radios--small",
          fieldset: { legend: { text: "Adjourned to", classes: "govuk-fieldset__legend--s" } },
          items: [
            { value: "next-list", text: "Next available possession list after" },
            { value: "next-date", text: "Next available date, not in a possession list, after" },
            {
              value: "specific",
              text: "A specific date",
              conditional: {
                html: govukInput({
                  id: "adj-specific-time",
                  name: "adj-specific-time",
                  label: { text: "Time of hearing" },
                  hint: { text: "For example, 10:30am" },
                  classes: "govuk-input--width-5",
                  spellcheck: false
                })
              }
            }
          ]
        }) }}

        {{ govukDateInput({
          id: "adj-hearing-date",
          namePrefix: "adj-hearing-date",
          fieldset: { legend: { text: "Date", classes: "govuk-fieldset__legend--s" } }
        }) }}

        {#
          The prototype gives the amount and the unit an aria-label each and no visible label, so
          neither is announced with the name of the thing being estimated. A fieldset names the pair
          once and each control keeps its own label.
        #}
        <div class="govuk-form-group">
          <fieldset class="govuk-fieldset" role="group">
            <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">Time estimate</legend>
            {{ govukInput({
              id: "adj-time-estimate",
              name: "adj-time-estimate",
              label: { text: "Length" },
              classes: "govuk-input--width-3",
              spellcheck: false,
              inputmode: "numeric"
            }) }}
            {{ govukSelect({
              id: "adj-time-estimate-unit",
              name: "adj-time-estimate-unit",
              label: { text: "Unit" },
              items: [
                { value: "minutes", text: "Minutes" },
                { value: "hours", text: "Hours" }
              ]
            }) }}
          </fieldset>
        </div>

        {#
          Checkboxes, as in the prototype: a hearing can be held in more than one format at once,
          with some parties attending in person and others by video.
        #}
        {{ govukCheckboxes({
          idPrefix: "adj-format",
          name: "adj-format",
          classes: "govuk-checkboxes--small govuk-checkboxes--inline",
          fieldset: { legend: { text: "Hearing format", classes: "govuk-fieldset__legend--s" } },
          items: [
            { value: "in-person", text: "In person" },
            { value: "video", text: "Video hearing" },
            { value: "telephone", text: "Telephone" }
          ]
        }) }}

        {#
          Each direction carries its own deadline, so the date belongs inside the reveal rather than
          beside the checkbox as a fourth column the way the prototype has it.
        #}
        {{ govukCheckboxes({
          idPrefix: "adj-directions",
          name: "adj-directions",
          classes: "govuk-checkboxes--small",
          fieldset: { legend: { text: "Directions", classes: "govuk-fieldset__legend--s" } },
          items: [
            {
              value: "defence",
              text: "The defendant must send a defence",
              conditional: {
                html: govukDateInput({
                  id: "adj-defence-date",
                  namePrefix: "adj-defence-date",
                  fieldset: { legend: { text: "By 4pm on", classes: "govuk-fieldset__legend--s" } }
                })
              }
            },
            {
              value: "counterclaim",
              text: "The defendant must send a defence and any counterclaim",
              conditional: {
                html: govukDateInput({
                  id: "adj-counterclaim-date",
                  namePrefix: "adj-counterclaim-date",
                  fieldset: { legend: { text: "By 4pm on", classes: "govuk-fieldset__legend--s" } }
                })
              }
            },
            {
              value: "claimant-reply",
              text: "The claimant must send a defence to the counterclaim and any reply",
              conditional: {
                html: govukDateInput({
                  id: "adj-claimant-reply-date",
                  namePrefix: "adj-claimant-reply-date",
                  fieldset: { legend: { text: "By 4pm on", classes: "govuk-fieldset__legend--s" } }
                })
              }
            }
          ]
        }) }}
      {% endset %}

      {# Adjourned generally: the payment conditions attached to the adjournment. #}
      {% set adjournGenerallyHtml %}
        {{ govukCheckboxes({
          idPrefix: "adj-gen",
          name: "adj-gen",
          classes: "govuk-checkboxes--small",
          fieldset: { legend: { text: "Conditions", classes: "govuk-fieldset__legend--s" } },
          items: [
            {
              value: "current-rent-plus",
              text: "On payment of current rent plus an additional sum",
              conditional: {
                html: govukInput({
                  id: "adj-gen-current-rent-plus-amount",
                  name: "adj-gen-current-rent-plus-amount",
                  label: { text: "Additional sum" },
                  classes: "govuk-input--width-5",
                  spellcheck: false,
                  inputmode: "numeric",
                  prefix: { text: "£" }
                }) + govukSelect({
                  id: "adj-gen-current-rent-plus-frequency",
                  name: "adj-gen-current-rent-plus-frequency",
                  label: { text: "How often" },
                  items: paymentFrequencies
                }) + govukDateInput({
                  id: "adj-gen-current-rent-plus-date",
                  namePrefix: "adj-gen-current-rent-plus-date",
                  fieldset: { legend: { text: "First payment by", classes: "govuk-fieldset__legend--s" } }
                })
              }
            },
            {
              value: "payments",
              text: "On regular payments",
              conditional: {
                html: govukInput({
                  id: "adj-gen-payments-amount",
                  name: "adj-gen-payments-amount",
                  label: { text: "Payments of" },
                  classes: "govuk-input--width-5",
                  spellcheck: false,
                  inputmode: "numeric",
                  prefix: { text: "£" }
                }) + govukSelect({
                  id: "adj-gen-payments-frequency",
                  name: "adj-gen-payments-frequency",
                  label: { text: "How often" },
                  items: paymentFrequencies
                }) + govukDateInput({
                  id: "adj-gen-payments-date",
                  namePrefix: "adj-gen-payments-date",
                  fieldset: { legend: { text: "First payment by", classes: "govuk-fieldset__legend--s" } }
                })
              }
            },
            {
              value: "oneoff",
              text: "On a single payment",
              conditional: {
                html: govukInput({
                  id: "adj-gen-oneoff-amount",
                  name: "adj-gen-oneoff-amount",
                  label: { text: "Payment of" },
                  classes: "govuk-input--width-5",
                  spellcheck: false,
                  inputmode: "numeric",
                  prefix: { text: "£" }
                }) + govukDateInput({
                  id: "adj-gen-oneoff-date",
                  namePrefix: "adj-gen-oneoff-date",
                  fieldset: { legend: { text: "Payment by", classes: "govuk-fieldset__legend--s" } }
                })
              }
            },
            {
              value: "restore",
              text: "Automatically struck out unless an application to restore is made",
              conditional: {
                html: govukDateInput({
                  id: "adj-gen-restore-date",
                  namePrefix: "adj-gen-restore-date",
                  fieldset: { legend: { text: "Application to restore by", classes: "govuk-fieldset__legend--s" } }
                })
              }
            }
          ]
        }) }}
      {% endset %}

      {#
        The prototype puts each branch's fields in a reveal that is a sibling of the radios rather
        than inside the radio item, so `aria-controls` points forwards out of the fieldset and the
        two blocks also carry their own <h4> headings to say which is which. Nesting them in the
        item they belong to is what govuk-frontend's conditional reveal is for, and it makes the
        headings unnecessary: each block is announced as part of the option that revealed it.
      #}
      {{ govukRadios({
        idPrefix: "adj-type",
        name: "adj-type",
        classes: "govuk-radios--small",
        fieldset: { legend: { text: "Adjournment type", classes: "govuk-fieldset__legend--s" } },
        items: [
          {
            value: "further-hearing",
            text: "Adjourned for further hearing",
            conditional: { html: adjournFurtherHearingHtml }
          },
          {
            value: "generally",
            text: "Adjourned generally",
            conditional: { html: adjournGenerallyHtml }
          }
        ]
      }) }}
    </div>

    <div class="govuk-tabs__panel govuk-tabs__panel--hidden" id="tab-strike-out">
      <h3 class="govuk-heading-m">Strike out/dismiss</h3>

      {{ govukRadios({
        name: "strike-claim-outcome",
        classes: "govuk-radios--small govuk-radios--inline",
        fieldset: { legend: { text: "Outcome", classes: "govuk-fieldset__legend--s" } },
        items: [
          { value: "struck-out", text: "Claim struck out" },
          { value: "dismissed", text: "Claim dismissed" }
        ]
      }) }}
    </div>

    <div class="govuk-tabs__panel govuk-tabs__panel--hidden" id="tab-free-form">
      <h3 class="govuk-heading-m">Free form</h3>

      {{ govukTextarea({
        id: "free-form-text",
        name: "free-form-text",
        rows: 8,
        label: { text: "Order wording", classes: "govuk-label--s" }
      }) }}
    </div>
  </div>

  <h2 class="govuk-heading-l govuk-!-margin-top-6">Costs</h2>

  {#
    One costs order per case, so these are radios sharing `costs-choice`, as in the prototype.

    Three of the ten are "payable on the same terms as the suspension", which only means anything
    when the order itself is a suspended one. The prototype ships them `disabled` and its script
    enables them while the Suspended tab is the active one. That cross-section dependency needs
    either script or a server round-trip, and there is neither yet, so all ten are enabled here and
    the three carry a hint saying what they require. A disabled radio is not announced as available
    and cannot be reached by keyboard, so shipping them disabled with no script would put three
    options on the page that no judge could ever use or find out about.

    Which is also the honest position for iteration 1: nothing is validated yet, so this is one more
    combination the eventual validation has to reject, not a special case.
  #}
  {% set costsSameTermsHint = "Only available with a suspended possession order." %}

  {#
    The amounts sit under the radio they belong to as a conditional reveal. The prototype puts each
    one inline on the radio's own line, labelled only by an aria-label, and drives the pairing with
    a `data-costs-selects` attribute and script — typing in a box selects its radio. Inline is more
    compact, but it needs the script to be coherent, and it leaves the box unlabelled on screen.
    Revealed below, the amount appears only when its option is chosen and carries a real label.
  #}
  {% set costsChoiceItems = [
    {
      value: "def-pay-cl-fixed",
      text: "Defendant pays claimant's fixed costs",
      conditional: {
        html: govukInput({
          id: "costs-def-pay-cl-fixed-amount",
          name: "costs-def-pay-cl-fixed-amount",
          label: { text: "Fixed costs of" },
          classes: "govuk-input--width-5",
          spellcheck: false,
          inputmode: "numeric",
          prefix: { text: "£" }
        })
      }
    },
    {
      value: "def-pay-cl-summary",
      text: "Defendant pays claimant's summary assessed costs",
      conditional: {
        html: govukInput({
          id: "costs-def-pay-cl-summary-amount",
          name: "costs-def-pay-cl-summary-amount",
          label: { text: "Summary assessed costs of" },
          classes: "govuk-input--width-5",
          spellcheck: false,
          inputmode: "numeric",
          prefix: { text: "£" }
        })
      }
    },
    {
      value: "cl-pay-def-summary",
      text: "Claimant pays defendant's summary assessed costs",
      conditional: {
        html: govukInput({
          id: "costs-cl-pay-def-summary-amount",
          name: "costs-cl-pay-def-summary-amount",
          label: { text: "Summary assessed costs of" },
          classes: "govuk-input--width-5",
          spellcheck: false,
          inputmode: "numeric",
          prefix: { text: "£" }
        })
      }
    },
    { value: "in-case", text: "Costs in the case" },
    { value: "reserved", text: "Costs reserved" },
    { value: "no-order", text: "No order as to costs" },
    { value: "public-funding", text: "Public funding assessment of the defendant's costs" },
    {
      value: "same-terms",
      text: "Costs payable on the same terms as the suspension",
      hint: { text: costsSameTermsHint }
    },
    {
      value: "fixed-same-terms",
      text: "Defendant pays claimant's fixed costs, payable on the same terms as the suspension",
      hint: { text: costsSameTermsHint }
    },
    {
      value: "summary-same-terms",
      text: "Defendant pays claimant's summary assessed costs, payable on the same terms as the suspension",
      hint: { text: costsSameTermsHint }
    },
    {
      value: "other",
      text: "Other",
      conditional: {
        html: govukInput({
          id: "costs-other-text",
          name: "costs-other-text",
          label: { text: "Costs order" },
          classes: "govuk-input--width-20"
        })
      }
    }
  ] %}

  {#
    The prototype splits these across two hand-built columns. One column here: its two are not two
    kinds of costs order — the split falls between "Cl pay Def summary costs" and the three
    same-terms options with no relationship to the seven on the left — so reading order down the
    left column then back up to the right is arbitrary, and a keyboard user's arrow keys walk the
    radios in DOM order regardless of where they are painted. Grouped by who pays instead, with the
    conditional ones last, which is an order a judge can predict.
  #}
  {{ govukCheckboxes({
    idPrefix: "costs",
    name: "costs",
    classes: "govuk-checkboxes--small",
    items: [{
      value: "yes",
      text: "Costs",
      conditional: {
        html: govukRadios({
          idPrefix: "costs-choice",
          name: "costs-choice",
          classes: "govuk-radios--small",
          fieldset: { legend: { text: "Costs order", classes: "govuk-visually-hidden" } },
          items: costsChoiceItems
        })
      }
    }]
  }) }}

  {#
    No heading here: the checkbox's own label already says "Staff message", so a heading above it
    only repeats itself — a screen reader user hears the words twice before reaching the control.
    The checkbox is a single optional extra rather than a section of the order, which is what the
    other headings mark.
  #}
  {{ govukCheckboxes({
    idPrefix: "staff-message",
    name: "staff-message",
    classes: "govuk-checkboxes--small",
    items: [{
      value: "yes",
      text: "Staff message",
      conditional: {
        html: govukTextarea({
          id: "staff-message-text",
          name: "staff-message-text",
          rows: 4,
          label: { text: "Message for court staff" }
        })
      }
    }]
  }) }}

  <div class="govuk-button-group govuk-!-margin-top-6">
    {{ govukButton({ text: "Send order to caseworker for issue", disabled: true }) }}
    {{ govukButton({ text: "Save as draft", classes: "govuk-button--secondary", disabled: true }) }}
  </div>
{% endblock %}
