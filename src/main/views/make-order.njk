{% extends "template.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "xui-header/macro.njk" import hmctsXuiHeader %}
{% from "footer/macro.njk" import hmctsUiFooter %}

{% set containerClasses = "pcs-wide" %}

{% set htmlClasses = "pcs-make-order" %}

{% block pageTitle %}
  Make an order - HM Courts &amp; Tribunals Service &ndash; GOV.UK
{% endblock %}

{% block head %}
  {{ super() }}
  <link rel="stylesheet" href="/assets/ui-component-lib/ui-component-lib.css">
{% endblock %}

{% block header %}
  {{ hmctsXuiHeader(headerModel) }}
{% endblock %}

{% block beforeContent %}{% endblock %}

{% block footer %}
  {{ hmctsUiFooter(footerModel) }}
{% endblock %}

{% block content %}
  {% include "make-order/_case-summary.njk" %}
  {% include "make-order/_case-facts.njk" %}
  {% include "make-order/_attendance.njk" %}
  {% include "make-order/_recitals.njk" %}

  <h2 class="govuk-heading-l govuk-!-margin-top-6">Order type</h2>

  {# One list drives both the tabs and their panels. #}
  {% set orderTypeTabs = [
    { id: "tab-outright", label: "Outright possession", template: "make-order/tabs/_outright.njk" },
    { id: "tab-suspended", label: "Suspended possession", template: "make-order/tabs/_suspended.njk" },
    { id: "tab-adjournment", label: "Adjournment", template: "make-order/tabs/_adjournment.njk" },
    { id: "tab-strike-out", label: "Strike out/dismiss", template: "make-order/tabs/_strike-out.njk" },
    { id: "tab-free-form", label: "Free form", template: "make-order/tabs/_free-form.njk" }
  ] %}

  {# The macro hardcodes an h2 tab-list heading, so use its markup directly to preserve heading order. #}
  <div class="govuk-tabs" data-module="govuk-tabs">
    <h3 class="govuk-tabs__title">Contents</h3>

    <ul class="govuk-tabs__list">
      {% for tab in orderTypeTabs %}
        <li class="govuk-tabs__list-item {%- if loop.first %} govuk-tabs__list-item--selected{% endif %}">
          <a class="govuk-tabs__tab" href="#{{ tab.id }}">{{ tab.label }}</a>
        </li>
      {% endfor %}
    </ul>

    {# govuk-frontend expects every panel after the first to start hidden. #}
    {% for tab in orderTypeTabs %}
      <div class="govuk-tabs__panel {%- if not loop.first %} govuk-tabs__panel--hidden{% endif %}" id="{{ tab.id }}">
        {% include tab.template %}
      </div>
    {% endfor %}
  </div>

  {% include "make-order/_costs.njk" %}
  {% include "make-order/_order-preview.njk" %}
  {% include "make-order/_staff-message.njk" %}

  <div class="govuk-button-group govuk-!-margin-top-6">
    {{ govukButton({ text: "Send order to caseworker for issue", disabled: true }) }}
    {{ govukButton({ text: "Save as draft", classes: "govuk-button--secondary", disabled: true }) }}
  </div>
{% endblock %}
