{#
  What a suspension is conditional on: the arrears, paid with the rent, and how they are paid. A suspended
  possession order and a suspended warrant ask it alike, with ids that start with the prefix. The conditions are
  one question, each payment row named for assistive technology.
#}
{% import "make-order/_compact.njk" as compact with context %}

{% macro paymentConditions(prefix, legend) %}
  {% set oneOffHtml %}
    {% call compact.row({ groupLabel: "One-off payment" }) %}
      {{ compact.money({ id: prefix + "-oneoff-amount", label: "One-off payment amount", labelHidden: true }) }}
      {{ compact.date({ id: prefix + "-oneoff-date", legend: "On or before" }) }}
    {% endcall %}
  {% endset %}

  {% set instalmentsHtml %}
    {% call compact.row({ groupLabel: "Instalments" }) %}
      {{ compact.money({ id: prefix + "-instalment-amount", label: "Instalment amount", labelHidden: true }) }}
      {{ compact.select(prefix + "-instalment-frequency", {
        label: "Instalment frequency",
        labelHidden: true,
        items: compact.paymentFrequencies,
        default: "monthly"
      }) }}
      {{ compact.date({ id: prefix + "-instalment-date", legend: "with the first payment by" }) }}
    {% endcall %}
  {% endset %}

  <div class="govuk-form-group">
    <fieldset class="govuk-fieldset">
      <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">{{ legend }}</legend>
      {% call compact.row({ classes: "govuk-!-margin-bottom-4" }) %}
        {{ compact.copy("Payment of current rent plus arrears of") }}
        {{ compact.money({
          id: prefix + "-arrears",
          label: "Arrears",
          labelHidden: true,
          formGroupClasses: "govuk-!-margin-bottom-0"
        }) }}
      {% endcall %}

      {# A single payment and instalments may both apply. #}
      {{ compact.checkboxes(prefix + "-payment-terms", {
        legend: "Arrears to be paid by",
        classes: "pcs-divided-options",
        formGroup: { classes: "govuk-!-margin-bottom-0" },
        items: [
          { value: "one-off", html: 'Payment of<span class="govuk-visually-hidden"> a one-off amount</span>', conditional: { html: oneOffHtml } },
          { value: "instalments", html: 'Payments of<span class="govuk-visually-hidden"> instalments</span>', conditional: { html: instalmentsHtml } }
        ]
      }) }}
    </fieldset>
  </div>
{% endmacro %}
