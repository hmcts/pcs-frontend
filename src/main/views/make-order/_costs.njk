{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% import "make-order/_compact.njk" as compact with context %}

<h2 class="govuk-heading-l govuk-!-margin-top-6">Costs</h2>

{#
  One costs-choice question in two banks: the claimant's costs and the orders that favour neither
  side on the left, the defendant's costs on the right. Each part is its own radios group sharing the name, so
  choosing in one clears the others.
#}
{% set claimantCostsChoices = [
  { value: "def-pay-cl-fixed", text: "Defendant pays claimant's fixed costs", amountLabel: "Fixed costs of" },
  { value: "def-pay-cl-summary", text: "Defendant pays claimant's summary assessed costs", amountLabel: "Summary assessed costs of" }
] %}

{% set suspendedCostsChoices = [
  { value: "same-terms", text: "Costs payable on the same terms as the suspension" },
  { value: "fixed-same-terms", text: "Defendant pays claimant's fixed costs, payable on the same terms as the suspension", amountLabel: "Fixed costs of" },
  { value: "summary-same-terms", text: "Defendant pays claimant's summary assessed costs, payable on the same terms as the suspension", amountLabel: "Summary assessed costs of" }
] %}

{% set defendantCostsChoices = [
  { value: "cl-pay-def-summary", text: "Claimant pays defendant's summary assessed costs", amountLabel: "Summary assessed costs of" },
  { value: "public-funding", text: "Public funding assessment of the defendant's costs" }
] %}

{% set otherCostsChoices = [
  { value: "in-case", text: "Costs in the case" },
  { value: "reserved", text: "Costs reserved" },
  { value: "no-order", text: "No order as to costs" },
  { value: "other", text: "Other" }
] %}

{% macro costRadios(choices, idPrefix, params={}) %}
  {% set items = [] %}
  {% for choice in choices %}
    {% set fields %}
      {% if choice.amountLabel %}
        {{ compact.money({ id: "costs-" + choice.value + "-amount", label: choice.amountLabel }) }}
      {% elif choice.value == "other" %}
        {{ compact.text("costs-other-text", { label: "Costs order" }) }}
      {% endif %}
    {% endset %}
    {% set items = items.concat([{
      value: choice.value,
      text: choice.text,
      checked: draftChecked("costs-choice", choice.value),
      disabled: params.disabled,
      attributes: { required: true } if not params.disabled,
      conditional: { html: fields } if choice.amountLabel or choice.value == "other"
    }]) %}
  {% endfor %}
  {{ govukRadios({
    idPrefix: idPrefix,
    name: "costs-choice",
    classes: "govuk-radios--small",
    fieldset: { legend: { text: params.legend, classes: "govuk-fieldset__legend--s" } } if params.legend,
    items: items,
    errorMessage: params.errorMessage
  }) }}
{% endmacro %}

{% set costsChoicesHtml %}
  <fieldset class="govuk-fieldset">
    <legend class="govuk-fieldset__legend govuk-visually-hidden">Costs order</legend>
    <div class="pcs-costs-columns">
      <div>
        {{ costRadios(claimantCostsChoices, "costs-choice", {
          legend: "Claimant's costs",
          errorMessage: validationErrors["costs-choice"]
        }) }}
        <div data-suspended-costs-column{% if draftOrderType != "SUSPENDED_POSSESSION" %} hidden{% endif %}>
          {{ costRadios(suspendedCostsChoices, "suspended-costs-choice", { disabled: draftOrderType != "SUSPENDED_POSSESSION" }) }}
        </div>
        {{ costRadios(otherCostsChoices, "other-costs-choice", { legend: "Neither party" }) }}
      </div>
      {{ costRadios(defendantCostsChoices, "defendant-costs-choice", { legend: "Defendant's costs" }) }}
    </div>
  </fieldset>
{% endset %}

{{ compact.reveal("costs", "Costs", costsChoicesHtml) }}
