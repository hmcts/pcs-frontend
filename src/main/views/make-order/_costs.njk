{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% import "make-order/_compact.njk" as compact %}

<h2 class="govuk-heading-l govuk-!-margin-top-6">Costs</h2>

{% set costsChoiceItems = [
  {
    value: "def-pay-cl-fixed",
    text: "Defendant pays claimant's fixed costs",
    checked: draftChecked("costs-choice", "def-pay-cl-fixed"),
    conditional: {
      html: compact.money({
        id: "costs-def-pay-cl-fixed-amount",
        label: "Fixed costs of",
        value: draftValue("costs-def-pay-cl-fixed-amount"),
        errorMessage: validationErrors["costs-def-pay-cl-fixed-amount"]
      })
    }
  },
  {
    value: "def-pay-cl-summary",
    text: "Defendant pays claimant's summary assessed costs",
    checked: draftChecked("costs-choice", "def-pay-cl-summary"),
    conditional: {
      html: compact.money({
        id: "costs-def-pay-cl-summary-amount",
        label: "Summary assessed costs of",
        value: draftValue("costs-def-pay-cl-summary-amount"),
        errorMessage: validationErrors["costs-def-pay-cl-summary-amount"]
      })
    }
  },
  {
    value: "cl-pay-def-summary",
    text: "Claimant pays defendant's summary assessed costs",
    checked: draftChecked("costs-choice", "cl-pay-def-summary"),
    conditional: {
      html: compact.money({
        id: "costs-cl-pay-def-summary-amount",
        label: "Summary assessed costs of",
        value: draftValue("costs-cl-pay-def-summary-amount"),
        errorMessage: validationErrors["costs-cl-pay-def-summary-amount"]
      })
    }
  },
  { value: "in-case", text: "Costs in the case", checked: draftChecked("costs-choice", "in-case") },
  { value: "reserved", text: "Costs reserved", checked: draftChecked("costs-choice", "reserved") },
  { value: "no-order", text: "No order as to costs", checked: draftChecked("costs-choice", "no-order") },
  { value: "public-funding", text: "Public funding assessment of the defendant's costs", checked: draftChecked("costs-choice", "public-funding") },
  {
    value: "other",
    text: "Other",
    checked: draftChecked("costs-choice", "other"),
    conditional: {
      html: govukInput({
        id: "costs-other-text",
        name: "costs-other-text",
        label: { text: "Costs order" },
        classes: "govuk-input--width-20",
        value: draftValue("costs-other-text")
      })
    }
  }
] %}

{% set suspendedCostsChoiceItems = [
  {
    value: "same-terms",
    text: "Costs payable on the same terms as the suspension",
    checked: draftChecked("costs-choice", "same-terms"),
    disabled: draftOrderType != "SUSPENDED_POSSESSION"
  },
  {
    value: "fixed-same-terms",
    text: "Defendant pays claimant's fixed costs, payable on the same terms as the suspension",
    checked: draftChecked("costs-choice", "fixed-same-terms"),
    disabled: draftOrderType != "SUSPENDED_POSSESSION",
    conditional: {
      html: compact.money({
        id: "costs-fixed-same-terms-amount",
        label: "Fixed costs of",
        value: draftValue("costs-fixed-same-terms-amount"),
        errorMessage: validationErrors["costs-fixed-same-terms-amount"]
      })
    }
  },
  {
    value: "summary-same-terms",
    text: "Defendant pays claimant's summary assessed costs, payable on the same terms as the suspension",
    checked: draftChecked("costs-choice", "summary-same-terms"),
    disabled: draftOrderType != "SUSPENDED_POSSESSION",
    conditional: {
      html: compact.money({
        id: "costs-summary-same-terms-amount",
        label: "Summary assessed costs of",
        value: draftValue("costs-summary-same-terms-amount"),
        errorMessage: validationErrors["costs-summary-same-terms-amount"]
      })
    }
  }
] %}

{% set costsChoicesHtml %}
  <fieldset class="govuk-fieldset">
    <legend class="govuk-fieldset__legend govuk-visually-hidden">Costs order</legend>
    <div class="pcs-costs-columns">
      {{ govukRadios({
        idPrefix: "costs-choice",
        name: "costs-choice",
        classes: "govuk-radios--small",
        items: costsChoiceItems
      }) }}
      <div data-suspended-costs-column{% if draftOrderType != "SUSPENDED_POSSESSION" %} hidden{% endif %}>
        {{ govukRadios({
          idPrefix: "suspended-costs-choice",
          name: "costs-choice",
          classes: "govuk-radios--small",
          items: suspendedCostsChoiceItems
        }) }}
      </div>
    </div>
  </fieldset>
{% endset %}

{{ govukCheckboxes({
  idPrefix: "costs",
  name: "costs",
  classes: "govuk-checkboxes--small",
  items: [{
    value: "yes",
    text: "Costs",
    checked: draftChecked("costs", "yes"),
    conditional: {
      html: costsChoicesHtml
    }
  }]
}) }}
