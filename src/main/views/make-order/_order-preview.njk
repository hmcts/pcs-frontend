<section class="govuk-!-margin-top-6" aria-labelledby="order-preview-heading">
  <h2 class="govuk-heading-l" id="order-preview-heading">Order preview</h2>
  <p class="govuk-body" id="order-preview-unavailable"{% if draftOrderType == "OUTRIGHT_POSSESSION" %} hidden{% endif %}>
    Order preview is not available for this order type yet. You can still save it as a draft.
  </p>
  <div id="order-preview-editor"{% if draftOrderType != "OUTRIGHT_POSSESSION" %} hidden{% endif %}>
    <div id="order-editor"></div>
  </div>
  <textarea hidden id="order-document" name="orderDocument">{{ orderDocumentJson }}</textarea>
</section>
