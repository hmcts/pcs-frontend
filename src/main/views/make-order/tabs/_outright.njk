{#
  Outright possession: the date possession is ordered by, the grounds, and any money judgment.

  Panel content only. The `.govuk-tabs__panel` wrapper, its id and its initial hidden state come from
  the tab list in make-order.njk, which includes this file — so nothing here needs to know which tab
  it is or whether that tab starts open.
#}
{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/date-input/macro.njk" import govukDateInput %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% import "make-order/_payment-frequencies.njk" as options %}

<h3 class="govuk-heading-m">Outright possession</h3>

{{ govukRadios({
  name: "outright-possession",
  classes: "govuk-radios--small",
  fieldset: { legend: { text: "Possession", classes: "govuk-fieldset__legend--s" } },
  items: [
    { value: "forthwith", text: "Possession forthwith" },
    {
      value: "by",
      text: "Possession on or before",
      conditional: {
        html: govukDateInput({
          id: "outright-by-date",
          namePrefix: "outright-by-date",
          fieldset: { legend: { text: "Date possession is ordered by", classes: "govuk-visually-hidden" } }
        })
      }
    }
  ]
}) }}

{{ govukRadios({
  name: "outright-grounds-type",
  classes: "govuk-radios--small govuk-radios--inline",
  fieldset: { legend: { text: "Grounds", classes: "govuk-fieldset__legend--s" } },
  items: [
    { value: "mandatory", text: "Mandatory" },
    { value: "discretionary", text: "Discretionary" }
  ]
}) }}

{#
  This field qualifies the Grounds radios above rather than asking anything new, so it is
  marked as a continuation and no dividing rule is drawn between the two — see make-order.scss.
#}
{{ govukInput({
  id: "outright-grounds-details",
  name: "outright-grounds-details",
  label: { text: "Details of grounds (optional)" },
  classes: "govuk-input--width-20",
  formGroup: { classes: "pcs-continues-question" }
}) }}

{#
  Money judgment. The prototype nests conditional reveals four deep here — money judgment
  reveals "judgment for arrears", which reveals "must be paid by", which reveals the payment
  plan, which reveals the balance date. Flattened to one level: the sums and the payment terms
  are shown together once money judgment is ticked.

  Nesting reveals is not a pattern govuk-frontend supports, and the deeper levels are the
  reason: a judge tabbing through has no way to know that ticking one box has grown three more
  levels somewhere below, and each level indents further until the fields are off to the right
  of the panel. Everything here is optional, so nothing is lost by showing it at once.
#}
{% set outrightMoneyJudgmentHtml %}
  {# The two sums are one row, as in the prototype, rather than a field and then a field. #}
  <div class="pcs-inline-fields">
    {{ govukInput({
      id: "outright-mj-arrears",
      name: "outright-mj-arrears",
      label: { text: "Judgment for arrears" },
      classes: "govuk-input--width-5",
      spellcheck: false,
      inputmode: "numeric",
      prefix: { text: "£" }
    }) }}

    {{ govukInput({
      id: "outright-mj-interest",
      name: "outright-mj-interest",
      label: { text: "Interest" },
      classes: "govuk-input--width-5",
      spellcheck: false,
      inputmode: "numeric",
      prefix: { text: "£" }
    }) }}
  </div>

  {#
    Checkboxes sharing one name, as the prototype has them — a lump sum and instalments can
    both apply to the same debt (a payment now, the rest over time), so this is two options
    rather than one choice. Same construct as the suspended tab's payment terms; the reasoning
    is written out there.
  #}
  {{ govukCheckboxes({
    idPrefix: "outright-mj-plan",
    name: "outright-mj-plan",
    classes: "govuk-checkboxes--small pcs-divided-options",
    fieldset: { legend: { text: "The above sums must be paid by", classes: "govuk-fieldset__legend--s" } },
    items: [
      {
        value: "lump",
        text: "Payment to claimant",
        conditional: {
          html: '<div class="pcs-inline-fields">' + govukInput({
            id: "outright-mj-lump-amount",
            name: "outright-mj-lump-amount",
            label: { text: "Payment of" },
            classes: "govuk-input--width-5",
            spellcheck: false,
            inputmode: "numeric",
            prefix: { text: "£" }
          }) + govukDateInput({
            id: "outright-mj-lump-date",
            namePrefix: "outright-mj-lump-date",
            fieldset: { legend: { text: "To be paid by", classes: "govuk-fieldset__legend--s" } }
          }) + govukDateInput({
            id: "outright-mj-balance-date",
            namePrefix: "outright-mj-balance-date",
            fieldset: { legend: { text: "And the balance by (optional)", classes: "govuk-fieldset__legend--s" } }
          }) + '</div>'
        }
      },
      {
        value: "instalments",
        text: "Instalment payments",
        conditional: {
          html: '<div class="pcs-inline-fields">' + govukInput({
            id: "outright-mj-inst-amount",
            name: "outright-mj-inst-amount",
            label: { text: "Instalment payments of" },
            classes: "govuk-input--width-5",
            spellcheck: false,
            inputmode: "numeric",
            prefix: { text: "£" }
          }) + govukSelect({
            id: "outright-mj-inst-freq",
            name: "outright-mj-inst-freq",
            label: { text: "How often" },
            items: options.paymentFrequencies
          }) + govukDateInput({
            id: "outright-mj-inst-date",
            namePrefix: "outright-mj-inst-date",
            fieldset: { legend: { text: "First instalment to be paid on or before", classes: "govuk-fieldset__legend--s" } }
          }) + '</div>'
        }
      }
    ]
  }) }}
{% endset %}

{{ govukCheckboxes({
  idPrefix: "outright-options",
  name: "outright-options",
  classes: "govuk-checkboxes--small pcs-divided-options",
  items: [
    {
      value: "money-judgment",
      text: "Money judgment",
      conditional: { html: outrightMoneyJudgmentHtml }
    },
    {
      value: "use-occupation",
      text: "Damages for unlawful occupation",
      conditional: {
        html: '<div class="pcs-inline-fields">' + govukInput({
          id: "outright-use-occupation-rate",
          name: "outright-use-occupation-rate",
          label: { text: "Daily rate" },
          classes: "govuk-input--width-5",
          spellcheck: false,
          inputmode: "decimal",
          prefix: { text: "£" }
        }) + govukDateInput({
          id: "outright-use-occupation-from-date",
          namePrefix: "outright-use-occupation-from-date",
          fieldset: { legend: { text: "From", classes: "govuk-fieldset__legend--s" } }
        }) + '</div>'
      }
    },
    {
      value: "transfer-high-court",
      text: "Transfer to High Court"
    }
  ]
}) }}
