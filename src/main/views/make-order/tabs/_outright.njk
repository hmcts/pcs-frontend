{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% import "make-order/_date-input.njk" as dateInput %}

<h3 class="govuk-heading-m">Outright possession</h3>

{{ govukRadios({
  name: "outright-possession",
  classes: "govuk-radios--small",
  fieldset: { legend: { text: "Possession", classes: "govuk-fieldset__legend--s" } },
  items: [
    { value: "forthwith", text: "Possession forthwith", checked: draftChecked("outright-possession", "forthwith") },
    {
      value: "by",
      text: "Possession on or before",
      checked: draftChecked("outright-possession", "by"),
      conditional: {
        html: dateInput.withPills({
          id: "outright-by-date",
          namePrefix: "outright-by-date",
          items: draftDate("outright-by-date"),
          fieldset: { legend: { text: "Date possession is ordered by", classes: "govuk-visually-hidden" } }
        })
      }
    }
  ]
}) }}

{{ govukRadios({
  name: "outright-grounds-type",
  classes: "govuk-radios--small govuk-radios--inline",
  fieldset: { legend: { text: "Grounds", classes: "govuk-fieldset__legend--s" } },
  items: [
    { value: "mandatory", text: "Mandatory", checked: draftChecked("outright-grounds-type", "mandatory") },
    { value: "discretionary", text: "Discretionary", checked: draftChecked("outright-grounds-type", "discretionary") }
  ]
}) }}

{# This field continues the Grounds question, so it has no divider. #}
{{ govukInput({
  id: "outright-grounds-details",
  name: "outright-grounds-details",
  label: { text: "Details of grounds (optional)" },
  classes: "govuk-input--width-20",
  formGroup: { classes: "pcs-continues-question" },
  value: draftValue("outright-grounds-details")
}) }}

{% set outrightMoneyJudgmentArrearsHtml %}
  <div id="outright-mj-amounts" class="pcs-inline-fields">
    <span class="pcs-inline-copy">Arrears</span>
    {{ govukInput({
      id: "outright-mj-arrears",
      name: "outright-mj-arrears",
      label: { text: "Arrears", classes: "govuk-visually-hidden" },
      classes: "govuk-input--width-5",
      spellcheck: false,
      value: draftValue("outright-mj-arrears"),
      inputmode: "numeric",
      prefix: { text: "£" }
    }) }}

    <span class="pcs-inline-copy">Interest</span>
    {{ govukInput({
      id: "outright-mj-interest",
      name: "outright-mj-interest",
      label: { text: "Interest", classes: "govuk-visually-hidden" },
      classes: "govuk-input--width-5",
      spellcheck: false,
      value: draftValue("outright-mj-interest"),
      inputmode: "numeric",
      prefix: { text: "£" }
    }) }}
  </div>
{% endset %}

{% set outrightMoneyJudgmentBalanceHtml %}
  {{ dateInput.withPills({
    id: "outright-mj-balance-date",
    namePrefix: "outright-mj-balance-date",
    items: draftDate("outright-mj-balance-date"),
    fieldset: { legend: { text: "Balance payment deadline", classes: "govuk-visually-hidden" } }
  }) }}
{% endset %}

{% set outrightMoneyJudgmentLumpHtml %}
  <div class="pcs-inline-fields">
    <span class="pcs-inline-copy">Payment of</span>
    {{ govukInput({
      id: "outright-mj-lump-amount",
      name: "outright-mj-lump-amount",
      label: { text: "Payment amount", classes: "govuk-visually-hidden" },
      classes: "govuk-input--width-5",
      spellcheck: false,
      value: draftValue("outright-mj-lump-amount"),
      inputmode: "numeric",
      prefix: { text: "£" }
    }) }}
    <span class="pcs-inline-copy">by</span>
    {{ dateInput.withPills({
      id: "outright-mj-lump-date",
      namePrefix: "outright-mj-lump-date",
      items: draftDate("outright-mj-lump-date"),
      fieldset: { legend: { text: "Payment deadline", classes: "govuk-visually-hidden" } }
    }) }}
  </div>

  {{ govukCheckboxes({
    idPrefix: "outright-mj-balance",
    name: "outright-mj-balance",
    classes: "govuk-checkboxes--small",
    items: [
      {
        value: "yes",
        text: "and the balance by",
        checked: draftChecked("outright-mj-balance", "yes"),
        conditional: { html: outrightMoneyJudgmentBalanceHtml }
      }
    ]
  }) }}
{% endset %}

{% set outrightMoneyJudgmentInstalmentsHtml %}
  <div class="pcs-inline-fields">
    <span class="pcs-inline-copy">Instalment payments of</span>
    {{ govukInput({
      id: "outright-mj-inst-amount",
      name: "outright-mj-inst-amount",
      label: { text: "Instalment amount", classes: "govuk-visually-hidden" },
      classes: "govuk-input--width-5",
      spellcheck: false,
      value: draftValue("outright-mj-inst-amount"),
      inputmode: "numeric",
      prefix: { text: "£" }
    }) }}
    {{ govukSelect({
      id: "outright-mj-inst-freq",
      name: "outright-mj-inst-freq",
      label: { text: "Instalment frequency", classes: "govuk-visually-hidden" },
      items: [
        { value: "weekly", text: "Weekly", selected: draftValue("outright-mj-inst-freq") == "weekly" },
        { value: "monthly", text: "Monthly", selected: draftValue("outright-mj-inst-freq") != "weekly" }
      ]
    }) }}
    <span class="pcs-inline-copy">the first instalment to be paid on or before</span>
    {{ dateInput.withPills({
      id: "outright-mj-inst-date",
      namePrefix: "outright-mj-inst-date",
      items: draftDate("outright-mj-inst-date"),
      fieldset: { legend: { text: "First instalment deadline", classes: "govuk-visually-hidden" } }
    }) }}
  </div>
{% endset %}

{% set outrightMoneyJudgmentPaymentPlanHtml %}
  {# A lump sum and instalments may both apply to the same debt. #}
  {{ govukCheckboxes({
    idPrefix: "outright-mj-plan",
    name: "outright-mj-plan",
    classes: "govuk-checkboxes--small",
    items: [
      {
        value: "lump",
        text: "Payment to claimant",
        checked: draftChecked("outright-mj-plan", "lump"),
        conditional: { html: outrightMoneyJudgmentLumpHtml }
      },
      {
        value: "instalments",
        text: "Instalment payments",
        checked: draftChecked("outright-mj-plan", "instalments"),
        conditional: { html: outrightMoneyJudgmentInstalmentsHtml }
      }
    ]
  }) }}
{% endset %}

{% set outrightMoneyJudgmentHtml %}
  {{ govukCheckboxes({
    idPrefix: "outright-mj-sections",
    name: "outright-mj-sections",
    classes: "govuk-checkboxes--small",
    items: [
      {
        value: "arrears",
        text: "Judgment for arrears",
        checked: draftChecked("outright-mj-sections", "arrears"),
        conditional: { html: outrightMoneyJudgmentArrearsHtml }
      },
      {
        value: "payment-plan",
        text: "The above sums must be paid by",
        checked: draftChecked("outright-mj-sections", "payment-plan"),
        conditional: { html: outrightMoneyJudgmentPaymentPlanHtml }
      }
    ]
  }) }}
{% endset %}

{{ govukCheckboxes({
  idPrefix: "outright-options",
  name: "outright-options",
  classes: "govuk-checkboxes--small pcs-divided-options",
  items: [
    {
      value: "money-judgment",
      text: "Money judgment",
      checked: draftChecked("outright-options", "money-judgment"),
      conditional: { html: outrightMoneyJudgmentHtml }
    },
    {
      value: "use-occupation",
      text: "Damages for unlawful occupation",
      checked: draftChecked("outright-options", "use-occupation"),
      conditional: {
        html: '<div class="pcs-inline-fields">' + govukInput({
          id: "outright-use-occupation-rate",
          name: "outright-use-occupation-rate",
          label: { text: "Daily rate" },
          classes: "govuk-input--width-5",
          spellcheck: false,
          value: draftValue("outright-use-occupation-rate"),
          inputmode: "decimal",
          prefix: { text: "£" }
        }) + '<span class="pcs-inline-copy">From</span>' + dateInput.withPills({
          id: "outright-use-occupation-from-date",
          namePrefix: "outright-use-occupation-from-date",
          items: draftDate("outright-use-occupation-from-date"),
          fieldset: { legend: { text: "Damages start date", classes: "govuk-visually-hidden" } }
        }) + '</div>'
      }
    },
    {
      value: "transfer-high-court",
      text: "Transfer to High Court",
      checked: draftChecked("outright-options", "transfer-high-court")
    }
  ]
}) }}
