{% from "govuk/components/error-message/macro.njk" import govukErrorMessage %}
{% import "make-order/_compact.njk" as compact with context %}

<h3 class="govuk-heading-m">Suspended possession</h3>

<div class="pcs-inline-date">
  <span class="govuk-label govuk-label--s pcs-inline-date__label" aria-hidden="true">Possession by</span>
  {{ compact.date({ id: "suspended-by-date", legend: "Possession by", legendHidden: true }) }}
</div>

{% call compact.row({ classes: "govuk-form-group" }) %}
  {{ compact.copy("Suspended on condition of payment of current rent plus arrears of") }}
  {{ compact.money({
    id: "suspended-arrears",
    label: "Arrears",
    labelHidden: true,
    formGroupClasses: "govuk-!-margin-bottom-0"
  }) }}
  {{ compact.copy("to be paid by") }}
{% endcall %}

{# A single payment and instalments may both apply; CaseMan keeps both rows visible, so this
   checkbox group is written out rather than using the macro, which would hide the fields. #}
{% set termsError = validationErrors["suspended-payment-terms"] %}
<div class="govuk-form-group{% if termsError %} govuk-form-group--error{% endif %}">
  {% if termsError %}
    {{ govukErrorMessage({ id: "suspended-payment-terms-error", text: termsError.text }) }}
  {% endif %}
  <div class="govuk-checkboxes govuk-checkboxes--small pcs-divided-options" data-module="govuk-checkboxes">
    <div class="govuk-checkboxes__item">
      <input class="govuk-checkboxes__input" id="suspended-payment-terms" name="suspended-payment-terms" type="checkbox" value="one-off"{% if termsError %} aria-describedby="suspended-payment-terms-error"{% endif %}{% if draftChecked("suspended-payment-terms", "one-off") %} checked{% endif %}>
      <label class="govuk-label govuk-checkboxes__label" for="suspended-payment-terms">Payment of<span class="govuk-visually-hidden"> a one-off amount</span></label>
    </div>
    {% call compact.row({ classes: "govuk-!-margin-left-7" }) %}
      {{ compact.money({ id: "suspended-oneoff-amount", label: "One-off payment amount", labelHidden: true }) }}
      {{ compact.date({ id: "suspended-oneoff-date", legend: "On or before" }) }}
    {% endcall %}

    <div class="govuk-checkboxes__item">
      <input class="govuk-checkboxes__input" id="suspended-payment-terms-2" name="suspended-payment-terms" type="checkbox" value="instalments"{% if draftChecked("suspended-payment-terms", "instalments") %} checked{% endif %}>
      <label class="govuk-label govuk-checkboxes__label" for="suspended-payment-terms-2">Payments of<span class="govuk-visually-hidden"> instalments</span></label>
    </div>
    {% call compact.row({ classes: "govuk-!-margin-left-7" }) %}
      {{ compact.money({ id: "suspended-instalment-amount", label: "Instalment amount", labelHidden: true }) }}
      {{ compact.select("suspended-instalment-frequency", {
        label: "Instalment frequency",
        labelHidden: true,
        items: compact.paymentFrequencies,
        default: "monthly"
      }) }}
      {{ compact.date({ id: "suspended-instalment-date", legend: "with the first payment by" }) }}
    {% endcall %}
  </div>
</div>

{# Same terms is only available when the money-judgment option reveals it. #}
{% set sameTermsHtml %}
  {{ compact.checkboxes("suspended-mj-same-terms", {
    items: [{
      value: "yes",
      text: "Suspended on the same terms as above",
      disabled: not draftChecked("suspended-options", "money-judgment-arrears")
    }]
  }) }}
{% endset %}

{% set useOccupationHtml %}
  {% call compact.row() %}
    {{ compact.money({ id: "suspended-use-occupation-rate", label: "Daily rate", inputmode: "decimal" }) }}
    {{ compact.date({ id: "suspended-use-occupation-from-date", legend: "From" }) }}
  {% endcall %}
{% endset %}

{{ compact.checkboxes("suspended-options", {
  classes: "pcs-divided-options",
  items: [
    { value: "money-judgment-arrears", text: "Money judgment for the arrears above", conditional: { html: sameTermsHtml } },
    { value: "money-claim-adjourned", text: "Money claim adjourned generally with liberty to restore" },
    { value: "use-occupation", text: "Damages for unlawful occupation", conditional: { html: useOccupationHtml } },
    { value: "warrant-on-notice", text: "Any application for a warrant of eviction must be made and heard on notice to all parties unless the court orders otherwise" },
    { value: "transfer-high-court", text: "Transfer to High Court" }
  ]
}) }}
