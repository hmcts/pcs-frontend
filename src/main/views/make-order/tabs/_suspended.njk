{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% import "make-order/_compact.njk" as compact %}
{% import "make-order/_payment-frequencies.njk" as options %}

<h3 class="govuk-heading-m">Suspended possession</h3>

<div class="pcs-inline-date">
  <span class="govuk-label govuk-label--s pcs-inline-date__label" aria-hidden="true">Possession by</span>
  {{ compact.date({
    id: "suspended-by-date",
    items: draftDate("suspended-by-date"),
    legend: "Possession by",
    legendHidden: true,
    errorMessage: validationErrors["suspended-by-date-day"]
  }) }}
</div>

{% call compact.row({ classes: "govuk-form-group" }) %}
  {{ compact.copy("Suspended on condition of payment of current rent plus arrears of") }}
  {{ compact.money({
    id: "suspended-arrears",
    label: "Arrears",
    labelHidden: true,
    formGroupClasses: "govuk-!-margin-bottom-0",
    value: draftValue("suspended-arrears"),
    errorMessage: validationErrors["suspended-arrears"]
  }) }}
  {{ compact.copy("to be paid by") }}
{% endcall %}

{# A single payment and instalments may both apply; CaseMan keeps both rows visible. #}
<div class="govuk-form-group{% if validationErrors['suspended-payment-terms'] %} govuk-form-group--error{% endif %}">
  {% if validationErrors["suspended-payment-terms"] %}
    {% from "govuk/components/error-message/macro.njk" import govukErrorMessage %}
    {{ govukErrorMessage({
      id: "suspended-payment-terms-error",
      text: validationErrors["suspended-payment-terms"].text,
      attributes: validationErrors["suspended-payment-terms"].attributes
    }) }}
  {% endif %}
<div class="govuk-checkboxes govuk-checkboxes--small pcs-divided-options" data-module="govuk-checkboxes">
  <div class="govuk-checkboxes__item">
    <input class="govuk-checkboxes__input" id="suspended-payment-terms" name="suspended-payment-terms" type="checkbox" value="one-off"{% if validationErrors["suspended-payment-terms"] %} aria-describedby="suspended-payment-terms-error"{% endif %}{% if draftChecked("suspended-payment-terms", "one-off") %} checked{% endif %}>
    <label class="govuk-label govuk-checkboxes__label" for="suspended-payment-terms">Payment of<span class="govuk-visually-hidden"> a one-off amount</span></label>
  </div>
  {% call compact.row({ classes: "govuk-!-margin-left-7" }) %}
    {{ compact.money({
      id: "suspended-oneoff-amount",
      label: "One-off payment amount",
      labelHidden: true,
      value: draftValue("suspended-oneoff-amount"),
      errorMessage: validationErrors["suspended-oneoff-amount"]
    }) }}
    {{ compact.date({
      id: "suspended-oneoff-date",
      items: draftDate("suspended-oneoff-date"),
      legend: "On or before",
      errorMessage: validationErrors["suspended-oneoff-date-day"]
    }) }}
  {% endcall %}

  <div class="govuk-checkboxes__item">
    <input class="govuk-checkboxes__input" id="suspended-payment-terms-2" name="suspended-payment-terms" type="checkbox" value="instalments"{% if draftChecked("suspended-payment-terms", "instalments") %} checked{% endif %}>
    <label class="govuk-label govuk-checkboxes__label" for="suspended-payment-terms-2">Payments of<span class="govuk-visually-hidden"> instalments</span></label>
  </div>
  {% call compact.row({ classes: "govuk-!-margin-left-7" }) %}
    {{ compact.money({
      id: "suspended-instalment-amount",
      label: "Instalment amount",
      labelHidden: true,
      value: draftValue("suspended-instalment-amount"),
      errorMessage: validationErrors["suspended-instalment-amount"]
    }) }}
    {{ govukSelect({
      id: "suspended-instalment-frequency",
      name: "suspended-instalment-frequency",
      label: { text: "Instalment frequency", classes: "govuk-visually-hidden" },
      items: draftSelect(options.paymentFrequencies, "suspended-instalment-frequency", "monthly")
    }) }}
    {{ compact.date({
      id: "suspended-instalment-date",
      items: draftDate("suspended-instalment-date"),
      legend: "with the first payment by",
      errorMessage: validationErrors["suspended-instalment-date-day"]
    }) }}
  {% endcall %}
</div>
</div>

{# Same terms is only available when the money-judgment option reveals it. #}
{% set suspendedSameTermsHtml %}
  {{ govukCheckboxes({
    idPrefix: "suspended-mj-same-terms",
    name: "suspended-mj-same-terms",
    classes: "govuk-checkboxes--small",
    items: [{
      value: "yes",
      text: "Suspended on the same terms as above",
      checked: draftChecked("suspended-mj-same-terms", "yes"),
      disabled: not draftChecked("suspended-options", "money-judgment-arrears")
    }]
  }) }}
{% endset %}

{% set suspendedUseOccupationHtml %}
  {% call compact.row() %}
    {{ compact.money({
      id: "suspended-use-occupation-rate",
      label: "Daily rate",
      inputmode: "decimal",
      value: draftValue("suspended-use-occupation-rate"),
      errorMessage: validationErrors["suspended-use-occupation-rate"]
    }) }}
    {{ compact.date({
      id: "suspended-use-occupation-from-date",
      items: draftDate("suspended-use-occupation-from-date"),
      legend: "From",
      errorMessage: validationErrors["suspended-use-occupation-from-date-day"]
    }) }}
  {% endcall %}
{% endset %}

{{ govukCheckboxes({
  idPrefix: "suspended-options",
  name: "suspended-options",
  classes: "govuk-checkboxes--small pcs-divided-options",
  items: [
    {
      value: "money-judgment-arrears",
      text: "Money judgment for the arrears above",
      checked: draftChecked("suspended-options", "money-judgment-arrears"),
      conditional: { html: suspendedSameTermsHtml }
    },
    { value: "money-claim-adjourned", text: "Money claim adjourned generally with liberty to restore", checked: draftChecked("suspended-options", "money-claim-adjourned") },
    {
      value: "use-occupation",
      text: "Damages for unlawful occupation",
      checked: draftChecked("suspended-options", "use-occupation"),
      conditional: { html: suspendedUseOccupationHtml }
    },
    {
      value: "warrant-on-notice",
      text: "Any application for a warrant of eviction must be made and heard on notice to all parties unless the court orders otherwise",
      checked: draftChecked("suspended-options", "warrant-on-notice")
    },
    { value: "transfer-high-court", text: "Transfer to High Court", checked: draftChecked("suspended-options", "transfer-high-court") }
  ]
}) }}
