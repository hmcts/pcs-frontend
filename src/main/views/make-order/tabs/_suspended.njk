{% import "make-order/_compact.njk" as compact with context %}
{% import "make-order/_payment-conditions.njk" as conditions with context %}

<h3 class="govuk-heading-m">Suspended possession</h3>

<div class="pcs-inline-date">
  <span class="govuk-label govuk-label--s pcs-inline-date__label" aria-hidden="true">Possession by</span>
  {{ compact.date({ id: "suspended-by-date", legend: "Possession by", legendHidden: true }) }}
</div>

{{ conditions.paymentConditions("suspended", "Suspended on condition of") }}

{# Same terms is only available when the money-judgment option reveals it. #}
{% set sameTermsHtml %}
  {{ compact.checkboxes("suspended-mj-same-terms", {
    items: [{
      value: "yes",
      text: "Suspended on the same terms as above",
      disabled: not draftChecked("suspended-options", "money-judgment-arrears")
    }]
  }) }}
{% endset %}

{{ compact.checkboxes("suspended-options", {
  legend: "Additional orders (optional)",
  classes: "pcs-divided-options",
  items: [
    { value: "money-judgment-arrears", text: "Money judgment for the arrears above", conditional: { html: sameTermsHtml } },
    { value: "money-claim-adjourned", text: "Money claim adjourned generally with liberty to restore" },
    { value: "warrant-on-notice", text: "Any application for a warrant of eviction must be made and heard on notice to all parties unless the court orders otherwise" }
  ]
}) }}
