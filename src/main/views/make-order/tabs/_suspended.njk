{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/date-input/macro.njk" import govukDateInput %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% import "make-order/_payment-frequencies.njk" as options %}

<h3 class="govuk-heading-m">Suspended possession</h3>

{{ govukDateInput({
  id: "suspended-by-date",
  namePrefix: "suspended-by-date",
  items: draftDate("suspended-by-date"),
  fieldset: { legend: { text: "Possession by", classes: "govuk-fieldset__legend--s" } }
}) }}

{{ govukInput({
  id: "suspended-arrears",
  name: "suspended-arrears",
  label: { text: "Arrears to be paid", classes: "govuk-label--s" },
  hint: { text: "Possession is suspended as long as the defendant pays the current rent as it falls due, plus these arrears." },
  classes: "govuk-input--width-5",
  spellcheck: false,
  value: draftValue("suspended-arrears"),
  inputmode: "numeric",
  prefix: { text: "£" }
}) }}

{# A single payment and instalments may both apply to the same arrears. #}
{{ govukCheckboxes({
  idPrefix: "suspended-payment-terms",
  name: "suspended-payment-terms",
  classes: "govuk-checkboxes--small pcs-divided-options",
  fieldset: { legend: { text: "Arrears to be paid by", classes: "govuk-fieldset__legend--s" } },
  items: [
    {
      value: "one-off",
      text: "A single payment",
      checked: draftChecked("suspended-payment-terms", "one-off"),
      conditional: {
        html: '<div class="pcs-inline-fields">' + govukInput({
          id: "suspended-oneoff-amount",
          name: "suspended-oneoff-amount",
          label: { text: "Payment of" },
          classes: "govuk-input--width-5",
          spellcheck: false,
          value: draftValue("suspended-oneoff-amount"),
          inputmode: "numeric",
          prefix: { text: "£" }
        }) + govukDateInput({
          id: "suspended-oneoff-date",
          namePrefix: "suspended-oneoff-date",
          items: draftDate("suspended-oneoff-date"),
          fieldset: { legend: { text: "On or before", classes: "govuk-fieldset__legend--s" } }
        }) + '</div>'
      }
    },
    {
      value: "instalments",
      text: "Instalment payments",
      checked: draftChecked("suspended-payment-terms", "instalments"),
      conditional: {
        html: '<div class="pcs-inline-fields">' + govukInput({
          id: "suspended-instalment-amount",
          name: "suspended-instalment-amount",
          label: { text: "Payments of" },
          classes: "govuk-input--width-5",
          spellcheck: false,
          value: draftValue("suspended-instalment-amount"),
          inputmode: "numeric",
          prefix: { text: "£" }
        }) + govukSelect({
          id: "suspended-instalment-frequency",
          name: "suspended-instalment-frequency",
          label: { text: "How often" },
          items: draftSelect(options.paymentFrequencies, "suspended-instalment-frequency")
        }) + govukDateInput({
          id: "suspended-instalment-date",
          namePrefix: "suspended-instalment-date",
          items: draftDate("suspended-instalment-date"),
          fieldset: { legend: { text: "First payment by", classes: "govuk-fieldset__legend--s" } }
        }) + '</div>'
      }
    }
  ]
}) }}

{# Same terms is only available when the money-judgment option reveals it. #}
{% set suspendedSameTermsHtml %}
  {{ govukCheckboxes({
    idPrefix: "suspended-mj-same-terms",
    name: "suspended-mj-same-terms",
    classes: "govuk-checkboxes--small",
    items: [{ value: "yes", text: "Suspended on the same terms as above", checked: draftChecked("suspended-mj-same-terms", "yes") }]
  }) }}
{% endset %}

{{ govukCheckboxes({
  idPrefix: "suspended-options",
  name: "suspended-options",
  classes: "govuk-checkboxes--small pcs-divided-options",
  items: [
    {
      value: "money-judgment-arrears",
      text: "Money judgment for the arrears above",
      checked: draftChecked("suspended-options", "money-judgment-arrears"),
      conditional: { html: suspendedSameTermsHtml }
    },
    { value: "money-claim-adjourned", text: "Money claim adjourned generally with liberty to restore", checked: draftChecked("suspended-options", "money-claim-adjourned") },
    {
      value: "use-occupation",
      text: "Damages for unlawful occupation",
      checked: draftChecked("suspended-options", "use-occupation"),
      conditional: {
        html: '<div class="pcs-inline-fields">' + govukInput({
          id: "suspended-use-occupation-rate",
          name: "suspended-use-occupation-rate",
          label: { text: "Daily rate" },
          classes: "govuk-input--width-5",
          spellcheck: false,
          value: draftValue("suspended-use-occupation-rate"),
          inputmode: "decimal",
          prefix: { text: "£" }
        }) + govukDateInput({
          id: "suspended-use-occupation-from-date",
          namePrefix: "suspended-use-occupation-from-date",
          items: draftDate("suspended-use-occupation-from-date"),
          fieldset: { legend: { text: "From", classes: "govuk-fieldset__legend--s" } }
        }) + '</div>'
      }
    },
    {
      value: "warrant-on-notice",
      text: "Any application for a warrant of eviction must be made and heard on notice to all parties unless the court orders otherwise",
      checked: draftChecked("suspended-options", "warrant-on-notice")
    },
    { value: "transfer-high-court", text: "Transfer to High Court", checked: draftChecked("suspended-options", "transfer-high-court") }
  ]
}) }}
