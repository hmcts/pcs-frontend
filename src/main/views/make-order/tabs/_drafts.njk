{% from "govuk/components/button/macro.njk" import govukButton %}

<h3 class="govuk-heading-m">Drafts</h3>

<p class="govuk-body">Draft orders the parties have filed, newest first. Using one makes this a free form order.</p>

{% for draft in drafts %}
  <section class="govuk-!-margin-bottom-6" aria-labelledby="draft-{{ draft.id }}-heading" data-filed-draft data-party="{{ draft.party }}">
    <h4 class="govuk-heading-s govuk-!-margin-bottom-1" id="draft-{{ draft.id }}-heading">{{ draft.party }}</h4>
    <p class="govuk-body-s govuk-!-margin-bottom-2">Filed on {{ draft.submittedAtDisplay }}</p>
    {# Cleaned by pcs-api when filed. #}
    <div class="govuk-inset-text govuk-!-margin-top-0" data-draft-wording>{{ draft.wording | safe }}</div>
    {{ govukButton({
      html: "Use this draft<span class=\"govuk-visually-hidden\"> from " + (draft.party | escape) + ", filed on " + draft.submittedAtDisplay + "</span>",
      type: "button",
      classes: "govuk-button--secondary",
      attributes: { "data-draft-order": draft.wording }
    }) }}
  </section>
{% endfor %}
