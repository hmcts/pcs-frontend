{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% import "make-order/_compact.njk" as compact %}
{% import "make-order/_payment-frequencies.njk" as options %}

<h3 class="govuk-heading-m">Adjournment</h3>

{#
  Each listing option carries its own date on the same row as its radio, so a judge
  can fill the date in one movement rather than selecting an option and then moving
  to a shared field. Typing in a row selects that row's radio (initOptionRows in
  make-order.ts), and only the selected option's date is read into the order.
  Hidden legends keep every control named for assistive technology.
#}
{% macro adjournWhenRow(params) %}
  <div class="pcs-option-row" data-option-row>
    <div class="govuk-radios__item pcs-option-row__choice">
      <input class="govuk-radios__input" id="{{ params.id }}" name="adj-when" type="radio" value="{{ params.value }}"{% if params.checked %} checked{% endif %}>
      <label class="govuk-label govuk-radios__label" for="{{ params.id }}">{{ params.text }}</label>
    </div>
    <div class="pcs-option-row__fields">
      {{ compact.date({
        id: "adj-hearing-date-" + params.value,
        items: draftDate("adj-hearing-date-" + params.value),
        legend: params.text,
        legendHidden: true
      }) }}
      {{ params.extraHtml | safe if params.extraHtml }}
    </div>
  </div>
{% endmacro %}

{# Only a specific date has a time; the other options are listed by the court. #}
{% set adjournSpecificTimeHtml %}
  {{ govukInput({
    id: "adj-specific-time",
    name: "adj-specific-time",
    label: { text: "Time of hearing" },
    hint: { text: "For example, 10:30am" },
    classes: "govuk-input--width-5",
    formGroup: { classes: "pcs-option-row__time" },
    spellcheck: false,
    value: draftValue("adj-specific-time")
  }) }}
{% endset %}

{% set adjournFurtherHearingHtml %}
  <div class="govuk-form-group">
    <fieldset class="govuk-fieldset" role="group">
      <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">Adjourned for further hearing conditions</legend>
      <div class="govuk-radios govuk-radios--small pcs-option-rows">
        {{ adjournWhenRow({
          id: "adj-when",
          value: "next-list",
          text: "Adjourned to next available possession list after",
          checked: draftChecked("adj-when", "next-list") or not draftValue("adj-when")
        }) }}
        {{ adjournWhenRow({
          id: "adj-when-2",
          value: "next-date",
          text: "Adjourned to next available date (non-possession list) after",
          checked: draftChecked("adj-when", "next-date")
        }) }}
        {{ adjournWhenRow({
          id: "adj-when-3",
          value: "specific",
          text: "Adjourned to specific date",
          checked: draftChecked("adj-when", "specific"),
          extraHtml: adjournSpecificTimeHtml
        }) }}
      </div>
    </fieldset>
  </div>

  <div id="adj-time-estimate-group" class="govuk-form-group pcs-section-break">
    <fieldset class="govuk-fieldset" role="group">
      <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">Time estimate</legend>
      {% call compact.row() %}
        {{ govukInput({
          id: "adj-time-estimate",
          name: "adj-time-estimate",
          label: { text: "Length", classes: "govuk-visually-hidden" },
          classes: "govuk-input--width-3",
          spellcheck: false,
          value: draftValue("adj-time-estimate"),
          inputmode: "numeric"
        }) }}
        {{ govukSelect({
          id: "adj-time-estimate-unit",
          name: "adj-time-estimate-unit",
          label: { text: "Unit", classes: "govuk-visually-hidden" },
          items: draftSelect([
            { value: "minutes", text: "Minutes" },
            { value: "hours", text: "Hours" }
          ], "adj-time-estimate-unit", "minutes")
        }) }}
      {% endcall %}
    </fieldset>
  </div>

  <div id="adj-format-group" class="pcs-section-break">
    {{ govukCheckboxes({
      idPrefix: "adj-format",
      name: "adj-format",
      classes: "govuk-checkboxes--small",
      fieldset: { legend: { text: "Hearing format", classes: "govuk-fieldset__legend--s" } },
      items: [
        { value: "in-person", text: "In person", checked: draftChecked("adj-format", "in-person") or not draftValue("adj-format") },
        { value: "video", text: "Video hearing", checked: draftChecked("adj-format", "video") },
        { value: "telephone", text: "Telephone", checked: draftChecked("adj-format", "telephone") }
      ]
    }) }}
  </div>

  {{ govukCheckboxes({
    idPrefix: "adj-directions",
    name: "adj-directions",
    classes: "govuk-checkboxes--small pcs-divided-options",
    formGroup: { classes: "pcs-section-break" },
    fieldset: { legend: { text: "Directions", classes: "govuk-fieldset__legend--s" } },
    items: [
      {
        value: "defence",
        text: "The defendant must send a defence",
        checked: draftChecked("adj-directions", "defence"),
        conditional: {
          html: compact.date({
            id: "adj-defence-date",
            items: draftDate("adj-defence-date"),
            legend: "By 4pm on"
          })
        }
      },
      {
        value: "counterclaim",
        text: "The defendant must send a defence and any counterclaim",
        checked: draftChecked("adj-directions", "counterclaim"),
        conditional: {
          html: compact.date({
            id: "adj-counterclaim-date",
            items: draftDate("adj-counterclaim-date"),
            legend: "By 4pm on"
          })
        }
      },
      {
        value: "claimant-reply",
        text: "The claimant must send a defence to the counterclaim and any reply",
        checked: draftChecked("adj-directions", "claimant-reply"),
        conditional: {
          html: compact.date({
            id: "adj-claimant-reply-date",
            items: draftDate("adj-claimant-reply-date"),
            legend: "By 4pm on"
          })
        }
      }
    ]
  }) }}
{% endset %}

{% set adjournGenCurrentRentPlusHtml %}
  {% call compact.row() %}
    {{ compact.money({
      id: "adj-gen-current-rent-plus-amount",
      label: "Additional sum",
      value: draftValue("adj-gen-current-rent-plus-amount")
    }) }}
    {{ govukSelect({
      id: "adj-gen-current-rent-plus-frequency",
      name: "adj-gen-current-rent-plus-frequency",
      label: { text: "How often" },
      items: draftSelect(options.paymentFrequencies, "adj-gen-current-rent-plus-frequency", "monthly")
    }) }}
    {{ compact.date({
      id: "adj-gen-current-rent-plus-date",
      items: draftDate("adj-gen-current-rent-plus-date"),
      legend: "First payment by"
    }) }}
  {% endcall %}
{% endset %}

{% set adjournGenPaymentsHtml %}
  {% call compact.row() %}
    {{ compact.money({
      id: "adj-gen-payments-amount",
      label: "Payments of",
      value: draftValue("adj-gen-payments-amount")
    }) }}
    {{ govukSelect({
      id: "adj-gen-payments-frequency",
      name: "adj-gen-payments-frequency",
      label: { text: "How often" },
      items: draftSelect(options.paymentFrequencies, "adj-gen-payments-frequency", "monthly")
    }) }}
    {{ compact.date({
      id: "adj-gen-payments-date",
      items: draftDate("adj-gen-payments-date"),
      legend: "First payment by"
    }) }}
  {% endcall %}
{% endset %}

{% set adjournGenOneoffHtml %}
  {% call compact.row() %}
    {{ compact.money({
      id: "adj-gen-oneoff-amount",
      label: "Payment of",
      value: draftValue("adj-gen-oneoff-amount")
    }) }}
    {{ compact.date({
      id: "adj-gen-oneoff-date",
      items: draftDate("adj-gen-oneoff-date"),
      legend: "Payment by"
    }) }}
  {% endcall %}
{% endset %}

{% set adjournGenerallyHtml %}
  {{ govukCheckboxes({
    idPrefix: "adj-gen",
    name: "adj-gen",
    classes: "govuk-checkboxes--small pcs-divided-options",
    fieldset: { legend: { text: "Conditions", classes: "govuk-fieldset__legend--s" } },
    items: [
      {
        value: "current-rent-plus",
        text: "On payment of current rent plus an additional sum",
        checked: draftChecked("adj-gen", "current-rent-plus"),
        conditional: { html: adjournGenCurrentRentPlusHtml }
      },
      {
        value: "payments",
        text: "On regular payments",
        checked: draftChecked("adj-gen", "payments"),
        conditional: { html: adjournGenPaymentsHtml }
      },
      {
        value: "oneoff",
        text: "On a single payment",
        checked: draftChecked("adj-gen", "oneoff"),
        conditional: { html: adjournGenOneoffHtml }
      },
      {
        value: "restore",
        text: "Automatically struck out unless an application to restore is made",
        checked: draftChecked("adj-gen", "restore"),
        conditional: {
          html: compact.date({
            id: "adj-gen-restore-date",
            items: draftDate("adj-gen-restore-date"),
            legend: "Application to restore by"
          })
        }
      }
    ]
  }) }}
{% endset %}

{{ govukRadios({
  idPrefix: "adj-type",
  name: "adj-type",
  classes: "govuk-radios--small pcs-inline-radios",
  fieldset: { legend: { text: "Adjournment type", classes: "govuk-fieldset__legend--s" } },
  items: [
    {
      value: "further-hearing",
      text: "Adjourned for further hearing",
      checked: draftChecked("adj-type", "further-hearing"),
      conditional: { html: adjournFurtherHearingHtml }
    },
    {
      value: "generally",
      text: "Adjourned generally",
      checked: draftChecked("adj-type", "generally"),
      conditional: { html: adjournGenerallyHtml }
    }
  ]
}) }}
