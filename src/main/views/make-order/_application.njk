{#
  An open application the order can decide, as a row of the applications section: what was applied for and by
  whom, the applicant's answers, documents and the order they asked for, then what the judge decides about it.
  Each application's answers start with its prefix (app-<id>), so an order made at a hearing keeps each one's.

  The details are folded away, as the judge has the file, but for the application the judge's task asked them to
  decide, which is open and which the order must decide. Any other may be left as it is.

  Granting reveals a button that puts the applicant's wording in the order preview as the judge's own clauses, after
  the clauses the decision generated, to amend or delete. Listing it for a hearing on notice asks when, as the adjournment tab
  does, and leaves the application open. For an application to suspend the warrant of possession, granting it
  suspends the warrant on the conditions a suspended possession order has, and dismissing it says when the eviction
  may go ahead (the judges' wording, 20 October 2026). Inline radios can't reveal a question, so what follows a
  decision is on its own rows, shown while it is chosen (initApplicationDecisions in make-order.ts).
#}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% import "make-order/_compact.njk" as compact with context %}
{% import "make-order/_listing.njk" as listing with context %}
{% import "make-order/_payment-conditions.njk" as conditions with context %}

{% macro details(application) %}
  {% if application.withoutNotice == "YES" %}
    {{ govukWarningText({ text: "The applicant asked for this application to be made without notice. Only the applicant will be told of it." }) }}
  {% endif %}

  {% set documentLinks %}
    {% if application.documents | length %}
      <ul class="govuk-list">
        {% for document in application.documents %}
          <li><a class="govuk-link" href="{{ document.href }}" target="_blank" rel="noopener">{{ document.fileName }} (opens in new tab)</a></li>
        {% endfor %}
      </ul>
    {% else %}
      None
    {% endif %}
  {% endset %}

  {% set rows = [
    { key: { text: "Submitted by" }, value: { text: application.applicant or "Not known" } },
    { key: { text: "Submitted on" }, value: { text: application.submittedOnDisplay or "Not known" } }
  ] %}
  {% if application.somethingElseDetails %}
    {% set rows = rows.concat([{ key: { text: "What the application is for" }, value: { text: application.somethingElseDetails } }]) %}
  {% endif %}
  {% if application.within14DaysDisplay %}
    {% set rows = rows.concat([{ key: { text: "Hearing in the next 14 days" }, value: { text: application.within14DaysDisplay } }]) %}
  {% endif %}
  {% set rows = rows.concat([
    { key: { text: "Other parties agree" }, value: { text: application.otherPartiesAgreedDisplay or "Not answered" } },
    { key: { text: "Without notice" }, value: { text: (application.withoutNoticeDisplay or "No") + ((": " + application.withoutNoticeReason) if application.withoutNoticeReason else "") } },
    { key: { text: "Application documents" }, value: { html: documentLinks } }
  ]) %}
  {{ govukSummaryList({ rows: rows, classes: "govuk-!-margin-bottom-4", attributes: { id: application.prefix + "-details" } }) }}

  <h4 class="govuk-heading-s">The order the applicant asked for</h4>
  {% if application.whatOrderWanted %}
    {# As the applicant wrote it, line by line, so their numbering is the numbering they refer to. #}
    {{ govukInsetText({
      html: application.whatOrderWantedHtml,
      attributes: { id: application.prefix + "-requested" }
    }) }}
  {% else %}
    <p class="govuk-body">The applicant did not say what order they want. Read the application documents.</p>
  {% endif %}
{% endmacro %}

{#
  The decision on the application: left as it is until the judge chooses another, but for the one their task asked
  them to decide, which starts undecided.
#}
{% macro decision(application) %}
  {% set prefix = application.prefix %}
  {% set name = prefix + "-decision" %}
  {{ compact.radios(name, {
    legend: "What do you decide about application " + application.reference + "?",
    classes: "govuk-radios--small govuk-radios--inline",
    default: none if application.required else "none",
    items: [
      { value: "none", text: "Not dealt with" },
      { value: "grant", text: "Granted" },
      { value: "dismiss", text: "Dismissed" },
      { value: "strike-out", text: "Struck out" },
      { value: "list", text: "Listed for a hearing on notice" },
      { value: "other", text: "Something else" }
    ]
  }) }}

  {% if application.whatOrderWanted %}
    {# Revealed by granting; the wording goes in only when the judge asks (judicial feedback, 22 October 2026). #}
    <div data-decision-shows="grant" {%- if not draftChecked(name, "grant") %} hidden{% endif %}>
      <button type="button" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-3" data-insert-requested-wording>
        Insert applicant’s wording
      </button>
    </div>
  {% endif %}

  {% if application.warrantSuspension %}
    <div data-decision-shows="grant" {%- if not draftChecked(name, "grant") %} hidden{% endif %}>
      {{ conditions.paymentConditions(prefix + "-warrant", "Warrant suspended on condition of") }}
    </div>
    <div data-decision-shows="dismiss" {%- if not draftChecked(name, "dismiss") %} hidden{% endif %}>
      <div class="pcs-inline-date">
        <span class="govuk-label govuk-label--s pcs-inline-date__label" aria-hidden="true">Eviction may take place on</span>
        {{ compact.date({ id: prefix + "-eviction-date", legend: "Eviction may take place on", legendHidden: true }) }}
      </div>
    </div>
  {% endif %}

  <div data-decision-shows="list" data-application-listing {%- if not draftChecked(name, "list") %} hidden{% endif %}>
    {{ listing.listing(prefix + "-list", "When the hearing is", [
      "Next available possession list after",
      "Next available date (non-possession list) after",
      "Specific date"
    ]) }}
  </div>
{% endmacro %}

{% macro row(application) %}
  {% set prefix = application.prefix %}
  <section class="pcs-application" aria-labelledby="{{ prefix }}-heading"
           data-application
           data-application-id="{{ application.id }}"
           data-application-prefix="{{ prefix }}"
           data-application-reference="{{ application.reference }}"
           data-application-applicant="{{ application.applicant or 'the applicant' }}"
           data-application-submitted="{{ application.submittedOnDisplay or '' }}"
           data-application-wording-html="{{ application.whatOrderWantedHtml }}"
           {%- if application.warrantSuspension %} data-application-warrant{% endif %}>
    <h3 class="govuk-heading-m govuk-!-margin-bottom-1" id="{{ prefix }}-heading">
      {{ application.reference }}: {{ application.type }}{% if application.somethingElseDetails %} – {{ application.somethingElseDetails }}{% endif %}
    </h3>
    <p class="govuk-body-s govuk-!-margin-bottom-2">
      {{ application.applicant or "Applicant not known" }}{% if application.submittedOnDisplay %}, {{ application.submittedOnDisplay }}{% endif %}
      {%- if application.withoutNotice == "YES" %}, without notice{% endif %}
    </p>
    {{ govukDetails({
      summaryText: "Application details and the order asked for",
      html: details(application),
      open: application.required,
      classes: "govuk-!-margin-bottom-3",
      attributes: { id: prefix + "-more" }
    }) }}
    {{ decision(application) }}
  </section>
{% endmacro %}
