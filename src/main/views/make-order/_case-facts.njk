{% from "govuk/components/date-input/macro.njk" import govukDateInput %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% import "make-order/_compact.njk" as compact with context %}

{% set tenancyTypes = [
  { value: "ASSURED_TENANCY", text: "Assured tenancy" },
  { value: "SECURE_TENANCY", text: "Secure tenancy" },
  { value: "INTRODUCTORY_TENANCY", text: "Introductory tenancy" },
  { value: "FLEXIBLE_TENANCY", text: "Flexible tenancy" },
  { value: "DEMOTED_TENANCY", text: "Demoted tenancy" },
  { value: "SECURE_CONTRACT", text: "Secure contract" },
  { value: "STANDARD_CONTRACT", text: "Standard contract" },
  { value: "OTHER", text: "Other" }
] %}

{% set rentFrequencies = [
  { value: "WEEKLY", text: "Weekly" },
  { value: "FORTNIGHTLY", text: "Fortnightly" },
  { value: "MONTHLY", text: "Monthly" },
  { value: "OTHER", text: "Other" }
] %}

<section class="pcs-case-facts" aria-labelledby="case-facts-heading" data-case-facts>
  <div class="pcs-case-facts__header">
    <div>
      <h2 class="govuk-heading-s" id="case-facts-heading">Case facts (tenancy/contract) <span class="govuk-!-font-weight-regular">(optional)</span></h2>
      {% if hearing %}
        <p class="govuk-body-s pcs-case-facts__source" id="case-facts-source">Hearing on {{ hearingDateDisplay }}. {{ factsRecordedDisplay }}.</p>
      {% endif %}
    </div>
    <button
      type="button"
      class="pcs-case-facts__toggle"
      aria-expanded="true"
      aria-controls="case-facts-content"
      data-case-facts-toggle
    >Hide case facts</button>
  </div>

  <div class="pcs-case-facts__layout" id="case-facts-content">
    <div class="pcs-case-facts__grid">
      {{ govukDateInput({
        id: "date-tenancy",
        namePrefix: "date-tenancy",
        items: draftDate("date-tenancy"),
        fieldset: { legend: { text: "Date of tenancy/contract", classes: "govuk-fieldset__legend--s" } }
      }) }}

      {{ govukSelect({
        id: "tenancy-type",
        name: "tenancy-type",
        label: { text: "Tenancy/contract type", classes: "govuk-label--s" },
        items: draftSelect(tenancyTypes, "tenancy-type")
      }) }}

      {{ govukDateInput({
        id: "date-notice",
        namePrefix: "date-notice",
        items: draftDate("date-notice"),
        fieldset: { legend: { text: "Date of service of notice", classes: "govuk-fieldset__legend--s" } }
      }) }}

      {{ compact.money({
        id: "arrears-notice",
        optional: true,
        label: "Arrears at notice",
        labelClasses: "govuk-label--s"
      }) }}

      {{ compact.money({
        id: "current-rent",
        optional: true,
        label: "Current rent",
        labelClasses: "govuk-label--s"
      }) }}

      {{ govukSelect({
        id: "rent-frequency",
        name: "rent-frequency",
        label: { text: "Rent frequency", classes: "govuk-label--s" },
        items: draftSelect(rentFrequencies, "rent-frequency")
      }) }}

      {{ govukInput({
        id: "grounds-pleaded",
        name: "grounds-pleaded",
        label: { text: "Grounds pleaded", classes: "govuk-label--s" },
        classes: "govuk-input--width-10",
        value: draftValue("grounds-pleaded")
      }) }}

      {{ compact.money({
        id: "arrears-issue",
        optional: true,
        label: "Arrears on issue",
        labelClasses: "govuk-label--s"
      }) }}

      {{ govukDateInput({
        id: "date-last-hearing",
        namePrefix: "date-last-hearing",
        items: draftDate("date-last-hearing"),
        fieldset: { legend: { text: "Date of last hearing", classes: "govuk-fieldset__legend--s" } }
      }) }}

      {{ govukDateInput({
        id: "date-last-payment",
        namePrefix: "date-last-payment",
        items: draftDate("date-last-payment"),
        fieldset: { legend: { text: "Date last payment made", classes: "govuk-fieldset__legend--s" } }
      }) }}

      {{ compact.money({
        id: "last-payment",
        optional: true,
        label: "Last payment",
        labelClasses: "govuk-label--s"
      }) }}

      {{ compact.money({
        id: "arrears-today",
        optional: true,
        label: "Arrears today",
        labelClasses: "govuk-label--s"
      }) }}
    </div>

    {#
      The case's judicial notes as a stack, newest first, under the note for this hearing; an order made
      without a hearing keeps a single notes field.
    #}
    {% set notesError = validationErrors["hearing-notes"] %}
    {% set currentNote = draftValue("hearing-notes") %}
    <div class="pcs-hearing-notes">
      <h3 class="govuk-heading-s govuk-!-margin-bottom-0">{{ "Judicial notes" if hearing else "Hearing notes" }}</h3>

      <div class="pcs-hearing-notes__stack">
        <div class="govuk-form-group govuk-!-margin-bottom-0 {%- if notesError %} govuk-form-group--error{% endif %}">
          <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" for="hearing-notes">
            {% if hearing %}Note for this hearing &ndash; {{ hearingDateDisplay }}{% else %}Hearing notes{% endif %} (optional, internal use only)
          </label>
          {% if notesError %}
            <p id="hearing-notes-error" class="govuk-error-message">
              <span class="govuk-visually-hidden">Error:</span> {{ notesError.text }}
            </p>
          {% endif %}
          <textarea class="govuk-textarea govuk-!-margin-bottom-0 {%- if notesError %} govuk-textarea--error{% endif %}"
            id="hearing-notes" name="hearing-notes" rows="{{ 3 if hearing else 8 }}"
            {%- if notesError %} aria-describedby="hearing-notes-error"{% endif %}>{{ currentNote }}</textarea>
        </div>

        {% if hearing %}
          {% if earlierNotes | length %}
            <ol class="pcs-hearing-notes__list" aria-label="Earlier judicial notes, newest first">
              {% for note in earlierNotes %}
                <li class="pcs-hearing-notes__note">
                  <p class="govuk-body-s govuk-!-font-weight-bold govuk-!-margin-bottom-1">{{ note.when }} &ndash; {{ note.by }}</p>
                  <p class="govuk-body-s govuk-!-margin-bottom-0 pcs-hearing-notes__text">{{ note.note }}</p>
                </li>
              {% endfor %}
            </ol>
          {% else %}
            <p class="govuk-body-s pcs-hearing-notes__empty">No earlier notes.</p>
          {% endif %}
        {% endif %}
      </div>
    </div>
  </div>
</section>
