{% from "govuk/components/date-input/macro.njk" import govukDateInput %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/textarea/macro.njk" import govukTextarea %}
{% import "make-order/_compact.njk" as compact with context %}

{#
  One hearing's facts and notes, its fields named for it (record.prefix): shown, and sent, while the order is made at
  that hearing. A macro, as an included template is not given the loop's hearing.
#}
{% macro panel(record) %}
{# A blank first option, so a fact the judge has not chosen is not recorded as the first one. A case in Wales has
   the claim's contracts, and one in England its tenancies. #}
{% set p = record.prefix %}
{% if record.inWales %}
  {% set tenancyTypes = [
    { value: "", text: "" },
    { value: "SECURE_CONTRACT", text: "Secure contract" },
    { value: "STANDARD_CONTRACT", text: "Standard contract" },
    { value: "OTHER", text: "Other" }
  ] %}
{% else %}
  {% set tenancyTypes = [
    { value: "", text: "" },
    { value: "ASSURED_TENANCY", text: "Assured tenancy" },
    { value: "SECURE_TENANCY", text: "Secure tenancy" },
    { value: "INTRODUCTORY_TENANCY", text: "Introductory tenancy" },
    { value: "FLEXIBLE_TENANCY", text: "Flexible tenancy" },
    { value: "DEMOTED_TENANCY", text: "Demoted tenancy" },
    { value: "OTHER", text: "Other" }
  ] %}
{% endif %}

{% set rentFrequencies = [
  { value: "", text: "" },
  { value: "WEEKLY", text: "Weekly" },
  { value: "FORTNIGHTLY", text: "Fortnightly" },
  { value: "MONTHLY", text: "Monthly" },
  { value: "OTHER", text: "Other" }
] %}

<fieldset class="pcs-case-facts" aria-labelledby="{{ p }}case-facts-heading" data-case-facts
          data-made-at="{{ record.id }}" {%- if not record.chosen %} hidden disabled{% endif %}>
  <input type="hidden" name="{{ p }}version" value="{{ draftValue(p + "version") }}">
  <div class="pcs-case-facts__header">
    <div>
      <h2 class="govuk-heading-s" id="{{ p }}case-facts-heading">Case facts (tenancy/contract) <span class="govuk-!-font-weight-regular">(optional)</span></h2>
      <p class="govuk-body-s pcs-case-facts__source" id="{{ p }}case-facts-source">{{ record.factsRecordedDisplay }}.</p>
    </div>
    <button
      type="button"
      class="pcs-case-facts__toggle"
      aria-expanded="true"
      aria-controls="{{ p }}case-facts-content"
      data-case-facts-toggle
    >Hide case facts</button>
  </div>

  <div class="pcs-case-facts__layout" id="{{ p }}case-facts-content">
    <div class="pcs-case-facts__grid">
      {{ govukDateInput({
        id: p + "date-tenancy",
        namePrefix: p + "date-tenancy",
        items: draftDate(p + "date-tenancy"),
        errorMessage: validationErrors[p + "date-tenancy-day"],
        fieldset: { legend: { text: "Date of tenancy/contract", classes: "govuk-fieldset__legend--s" } }
      }) }}

      {{ govukSelect({
        id: p + "tenancy-type",
        name: p + "tenancy-type",
        label: { text: "Tenancy/contract type", classes: "govuk-label--s" },
        items: draftSelect(tenancyTypes, p + "tenancy-type")
      }) }}

      {{ govukDateInput({
        id: p + "date-notice",
        namePrefix: p + "date-notice",
        items: draftDate(p + "date-notice"),
        errorMessage: validationErrors[p + "date-notice-day"],
        fieldset: { legend: { text: "Date of service of notice", classes: "govuk-fieldset__legend--s" } }
      }) }}

      {{ compact.money({
        id: p + "arrears-notice",
        optional: true,
        label: "Arrears at notice",
        labelClasses: "govuk-label--s"
      }) }}

      {{ compact.money({
        id: p + "current-rent",
        optional: true,
        label: "Current rent",
        labelClasses: "govuk-label--s"
      }) }}

      {{ govukSelect({
        id: p + "rent-frequency",
        name: p + "rent-frequency",
        label: { text: "Rent frequency", classes: "govuk-label--s" },
        items: draftSelect(rentFrequencies, p + "rent-frequency")
      }) }}

      {{ govukInput({
        id: p + "grounds-pleaded",
        name: p + "grounds-pleaded",
        label: { text: "Grounds pleaded", classes: "govuk-label--s" },
        classes: "govuk-input--width-10",
        value: draftValue(p + "grounds-pleaded")
      }) }}

      {{ compact.money({
        id: p + "arrears-issue",
        optional: true,
        label: "Arrears on issue",
        labelClasses: "govuk-label--s"
      }) }}

      {{ govukDateInput({
        id: p + "date-last-payment",
        namePrefix: p + "date-last-payment",
        items: draftDate(p + "date-last-payment"),
        errorMessage: validationErrors[p + "date-last-payment-day"],
        fieldset: { legend: { text: "Date last payment made", classes: "govuk-fieldset__legend--s" } }
      }) }}

      {{ compact.money({
        id: p + "last-payment",
        optional: true,
        label: "Last payment",
        labelClasses: "govuk-label--s"
      }) }}

      {{ compact.money({
        id: p + "arrears-today",
        optional: true,
        label: "Arrears today",
        labelClasses: "govuk-label--s"
      }) }}
    </div>

    {# The case's judicial notes as a stack, newest first, under the note for this hearing. #}
    <div class="pcs-hearing-notes">
      <h3 class="govuk-heading-s govuk-!-margin-bottom-0">Judicial notes</h3>

      {{ govukTextarea({
        id: p + "notes",
        name: p + "notes",
        rows: 4,
        value: draftValue(p + "notes"),
        label: {
          text: "Note for this hearing – " + record.hearingDateDisplay + " (optional, internal use only)",
          classes: "govuk-visually-hidden"
        },
        errorMessage: validationErrors[p + "notes"],
        formGroup: { classes: "govuk-!-margin-bottom-0" },
        classes: "govuk-!-margin-bottom-0"
      }) }}

      <div class="pcs-hearing-notes__stack">
        {% if record.earlierNotes | length %}
          <ol class="pcs-hearing-notes__list" aria-label="Earlier judicial notes, newest first">
            {% for note in record.earlierNotes %}
              <li class="pcs-hearing-notes__note">
                <p class="govuk-body-s govuk-!-font-weight-bold govuk-!-margin-bottom-1">{{ note.by }} on {{ note.dateMade }}</p>
                <p class="govuk-body-s govuk-!-margin-bottom-0 pcs-hearing-notes__text">{{ note.note }}</p>
              </li>
            {% endfor %}
          </ol>
        {% else %}
          <p class="govuk-body-s pcs-hearing-notes__empty">No earlier notes.</p>
        {% endif %}
      </div>
    </div>
  </div>
</fieldset>
{% endmacro %}
