{% macro dateInput(id, label, hint, values = {}, errorMessage = undefined) %}
<div class="govuk-form-group{% if errorMessage %} govuk-form-group--error{% endif %}">
<fieldset class="govuk-fieldset" role="group" aria-describedby="{{ id }}-hint{% if errorMessage %} {{ id }}-error{% endif %}">
    <legend class="govuk-fieldset__legend">
      {{ label }}
    </legend>
    <div id="{{ id }}-hint" class="govuk-hint">
      {{ hint }}
    </div>
    {% if errorMessage %}
      <p id="{{ id }}-error" class="govuk-error-message">
        <span class="govuk-visually-hidden">Error:</span> {{ errorMessage }}
      </p>
    {% endif %}
    <div class="govuk-date-input" id="{{ id }}">
      <div class="govuk-date-input__item">
        <div class="govuk-form-group">
          <label class="govuk-label govuk-date-input__label" for="{{ id }}-day">
            Day
          </label>
          <input class="govuk-input govuk-date-input__input govuk-input--width-2{% if errorMessage %} govuk-input--error{% endif %}" id="{{ id }}-day" name="{{ id }}-day" type="text" inputmode="numeric" value="{{ values.day }}">
        </div>
      </div>
      <div class="govuk-date-input__item">
        <div class="govuk-form-group">
          <label class="govuk-label govuk-date-input__label" for="{{ id }}-month">
            Month
          </label>
          <input class="govuk-input govuk-date-input__input govuk-input--width-2{% if errorMessage %} govuk-input--error{% endif %}" id="{{ id }}-month" name="{{ id }}-month" type="text" inputmode="numeric" value="{{ values.month }}">
        </div>
      </div>
      <div class="govuk-date-input__item">
        <div class="govuk-form-group">
          <label class="govuk-label govuk-date-input__label" for="{{ id }}-year">
            Year
          </label>
          <input class="govuk-input govuk-date-input__input govuk-input--width-4{% if errorMessage %} govuk-input--error{% endif %}" id="{{ id }}-year" name="{{ id }}-year" type="text" inputmode="numeric" value="{{ values.year }}">
        </div>
      </div>
      <div class="govuk-date-input__item">
        <div class="govuk-form-group">
          <label class="govuk-label govuk-date-input__label" for="{{ id }}-hour">
            Hour
          </label>
          <input class="govuk-input govuk-date-input__input govuk-input--width-4{% if errorMessage %} govuk-input--error{% endif %}" id="{{ id }}-hour" name="{{ id }}-hour" type="text" inputmode="numeric" value="{{ values.hour }}">
        </div>
      </div>
      <div class="govuk-date-input__item">
          <div class="govuk-form-group">
            <label class="govuk-label govuk-date-input__label" for="{{ id }}-minute">
              Minute
            </label>
            <input class="govuk-input govuk-date-input__input govuk-input--width-4{% if errorMessage %} govuk-input--error{% endif %}" id="{{ id }}-minute" name="{{ id }}-minute" type="text" inputmode="numeric" value="{{ values.minute }}">
          </div>
        </div>
    </div>
  </fieldset>
</div>
{% endmacro %}
