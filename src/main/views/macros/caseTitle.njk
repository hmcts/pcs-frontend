{% macro caseTitle(params) %}
  {% if params.eventName %}
    <span class="govuk-caption-l">{{ params.eventName }}</span>
  {% endif %}
  <h1 class="govuk-heading-l govuk-!-margin-bottom-4">{{ params.heading }}</h1>

  <p class="govuk-body govuk-!-font-size-24 govuk-!-margin-bottom-1">
    Case number: {{ params.caseReference }}
  </p>
  <p class="govuk-body govuk-!-font-size-24 govuk-!-margin-bottom-1">
    Property address: {{ params.propertyAddress }}
  </p>
  <p class="govuk-body govuk-!-font-size-24">
    {% if params.caseName %}
      {{ params.caseName }}
    {% elif params.claimantNames is defined %}
      {{ params.claimantNames }} vs {{ params.defendantNames }}
    {% endif %}
  </p>
{% endmacro %}
