{% macro pcsDocumentList(folder, caseReference, submittedOnLabel) %}
  <div class="govuk-summary-card govuk-!-margin-bottom-6">
    <div class="govuk-summary-card__title-wrapper">
      <h2 class="govuk-summary-card__title">{{ folder.title }}</h2>
    </div>
    <div class="govuk-summary-card__content">
      <ul class="govuk-list pcs-document-list">
        {% for document in folder.documents %}
          <li class="pcs-document-list__item">
            <a class="govuk-link" href="/case/{{ caseReference }}/view-documents/{{ document.id }}" target="_blank" rel="noopener noreferrer">{{ document.filename }}</a>
            {% if document.submittedOn %}
              <div class="govuk-hint govuk-!-margin-bottom-0">{{ submittedOnLabel }} {{ document.submittedOn | date }}</div>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
{% endmacro %}
