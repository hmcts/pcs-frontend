{% extends "stepsTemplate.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/input/macro.njk" import govukInput %}

{% block pageTitle %}{{ pageTitle }} &ndash; HM Courts &amp; Tribunals Service &ndash; GOV.UK{% endblock %}

{% block mainContent %}
  {% if errorSummary %}
    {{ govukErrorSummary(errorSummary) }}
  {% endif %}

  <h1 class="govuk-heading-l">{{ pageTitle }}</h1>

  <div class="govuk-!-margin-top-6">
    {{ govukSummaryList({
      classes: 'pcs-fee-summary-list',
      rows: [
        {
          key: { text: counterClaimAmountLabel },
          value: { text: formattedCounterClaimAmount or notApplicable }
        },
        {
          key: { text: counterClaimFeeLabel },
          value: { text: formattedCounterClaimFee }
        }
      ]
    }) }}
  </div>

  {% if showPaymentError %}
    <p class="govuk-error-message">{{ paymentError }}</p>
  {% endif %}

  {% if isLegalRepresentative %}
    <form method="post" novalidate>
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">

      {% set pbaAccountlHtml %}
        {{ govukSelect({
          id: "pbaAccounts",
          name: "paymentOptions.pbaAccounts",
          label: {
            text: "Select PBA account"
          },
          items: pbaAccountItems,
          value: form.pbaAccounts,
          errorMessage: errors.pbaAccounts
        }) }}

        {{ govukInput({
              id: 'customerReference',
              name: 'paymentOptions.customerReference',
              label: {
                text: "Enter a reference for your PBA account statements"
              }
        }) }}
      {% endset -%}

    {% for field in fields %}
      {% if field.componentType == 'radios' %}
        {% set updatedItems = [] %}

        {% for item in field.component.items %}
          {% if item.value == 'pba' %}
            {% set updatedItems = (updatedItems.push({
              value: item.value,
              text: item.text,
              checked: item.checked,
              conditional: {
                html: pbaAccountlHtml
              }
            }), updatedItems) %}
          {% else %}
            {% set updatedItems = (updatedItems.push(item), updatedItems) %}
          {% endif %}
        {% endfor %}

        {{ govukRadios({
          name: field.component.name,
          fieldset: field.component.fieldset,
          hint: field.component.hint,
          errorMessage: field.component.errorMessage,
          items: updatedItems
        }) }}
      {% endif %}
    {% endfor %}

      {{ govukButton({
        text: payNowButton,
        disabled: payNowDisabled
      }) }}
    </form>
  {% else %}
    {{ govukButton({
      text: payNowButton,
      href: payNowUrl,
      disabled: payNowDisabled
    }) }}
  {% endif %}
{% endblock %}