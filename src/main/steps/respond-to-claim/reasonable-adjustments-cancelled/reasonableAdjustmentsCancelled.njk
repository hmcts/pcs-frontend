{% extends "stepsTemplate.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "macros/csrf.njk" import csrfProtection %}

{% block pageTitle %}{{ pageTitle }} &ndash; HM Courts &amp; Tribunals Service &ndash; GOV.UK{% endblock %}

{% block mainContent %}
  <h1 class="govuk-heading-l">{{ heading }}</h1>

  {# POSTs rather than linking straight on, so the step can hand the citizen to PCQ first. #}
  <form method="post" action="{{ url }}">
    {{ govukButton({
      text: continueButton,
      attributes: { name: 'action', value: 'continue' }
    }) }}
    {{ csrfProtection(csrfToken) }}
  </form>
{% endblock %}
