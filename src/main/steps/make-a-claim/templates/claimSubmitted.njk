{% extends "make-a-claim/templates/layout.njk" %}
{% from "govuk/components/panel/macro.njk" import govukPanel %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% block mainContent %}
  {{ govukPanel({ titleText: panelTitle, html: panelText }) }}
  {% if paymentReferenceText %}
    <p class="govuk-body">{{ paymentReferenceText | safe }}</p>
  {% endif %}
  {% for paragraph in submittedIntro %}
    <p class="govuk-body">{{ paragraph }}</p>
  {% endfor %}
  {% for paragraph in generalApplicationAndSupport %}
    <p class="govuk-body">{{ paragraph | safe }}</p>
  {% endfor %}
  <h2 class="govuk-heading-m">{{ whatHappensNextHeading }}</h2>
  {% for paragraph in whatHappensNext %}
    <p class="govuk-body">{{ paragraph }}</p>
  {% endfor %}
  {% if totalAmount %}
    <h2 class="govuk-heading-m">{{ paymentSummaryHeading }}</h2>
    {{ govukSummaryList({
      rows: [
        { key: { text: paymentForLabel }, value: { text: claimFeeName } },
        { key: { text: totalAmountLabel }, value: { text: totalAmount } }
      ]
    }) }}
  {% endif %}
  <h2 class="govuk-heading-m">{{ claimFormHeading }}</h2>
  <p class="govuk-body">{{ claimFormText }}</p>
  <p class="govuk-body"><a class="govuk-link" href="{{ viewDocumentsUrl }}">{{ claimFormLink }}</a></p>
  {{ govukButton({ text: closeButton, href: overviewUrl }) }}
  <p class="govuk-body"><a class="govuk-link" href="{{ feedbackUrl }}" target="_blank" rel="noopener noreferrer">{{ feedbackLink }}</a></p>
{% endblock %}
