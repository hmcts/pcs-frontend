{% extends "make-a-claim/templates/question.njk" %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/table/macro.njk" import govukTable %}

{% block beforeForm %}
  {% for card in cards %}
    {{ govukSummaryList({ card: { title: { text: card.title } }, rows: card.rows, attributes: { id: 'summary-' + card.id } }) }}
    {% if card.table %}
      {{ govukTable(card.table) }}
      <p class="govuk-body govuk-!-margin-bottom-8"><a class="govuk-link" href="{{ card.tableChange.href }}">{{ card.tableChange.text }}</a></p>
    {% endif %}
  {% endfor %}
{% endblock %}
