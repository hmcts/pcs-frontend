{% extends "make-a-claim/templates/layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block mainContent %}
  <h1 class="govuk-heading-l">{{ heading }}</h1>
  {% for paragraph in paragraphs %}
    <p class="govuk-body">{{ paragraph | safe }}</p>
  {% endfor %}
  <h2 class="govuk-heading-m">{{ eligibilityHeading }}</h2>
  <p class="govuk-body">{{ eligibilityIntro }}</p>
  <ul class="govuk-list govuk-list--bullet">
    {% for bullet in bullets %}
      <li>{{ bullet }}</li>
    {% endfor %}
  </ul>
  {% for paragraph in afterBullets %}
    <p class="govuk-body">{{ paragraph | safe }}</p>
  {% endfor %}
  <h2 class="govuk-heading-m">{{ afterClaimHeading }}</h2>
  <p class="govuk-body">{{ afterClaimText }}</p>
  {{ govukButton({ text: startButton, href: startUrl, isStartButton: true }) }}
{% endblock %}
