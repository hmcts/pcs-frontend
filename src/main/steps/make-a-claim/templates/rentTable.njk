{% extends "make-a-claim/templates/question.njk" %}
{% from "govuk/components/table/macro.njk" import govukTable %}

{% block beforeForm %}
  {% if rentTable %}
    {{ govukTable(rentTable) }}
    <p class="govuk-body govuk-!-font-weight-bold">{{ totalArrearsLabel }} {{ totalArrears }}</p>
  {% else %}
    <p class="govuk-body">{{ emptyTable }}</p>
  {% endif %}
{% endblock %}
