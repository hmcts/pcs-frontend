# exclude all by default

*

# exceptions from `exclude all` rule

!package.json
!yarn.lock
!version
!.yarn/**
!.yarnrc.yml
!.pnp.cjs

!tsconfig.json
!webpack/**
!src/main/**
!config/**
!webpack.config.js
!src/types/**
!bin/**

# ACR reads both of these from inside the uploaded context tarball, so the `*`
# rule above must not exclude them or the remote build cannot start.
!acb.yaml
!Dockerfile
