# exclude all by default

*

# exceptions from `exclude all` rule

!package.json
!yarn.lock
!version
!.yarn/**
!.yarnrc.yml
!.pnp.cjs

!tsconfig.json
!webpack/**
!src/main/**
!config/**
!webpack.config.js
!src/types/**
!bin/**

# The ACR build is driven by acb.yaml (generated from acb.tpl.yaml by the Jenkins
# library). `az acr run` reads it from inside the uploaded context tarball, so it
# must survive the `*` exclusion above or the remote build fails to start.
!acb.yaml
!Dockerfile
